    fn render_thread_window_v2(&mut self, ctx: &egui::Context) {
        if !self.show_thread_form {
            return;
        }
        let title = self.tr("鏂板缓绾跨▼", "Create Thread").to_string();
        let mut create = false;
        let mut cancel = false;
        let mut open = self.show_thread_form;

        egui::Window::new(title)
            .open(&mut open)
            .collapsible(false)
            .resizable(false)
            .default_width(420.0)
            .show(ctx, |ui| {
                ui.label(self.tr("绾跨▼鍚嶇О", "Thread name"));
                ui.text_edit_singleline(&mut self.thread_form.name);
                ui.label(self.tr("绾跨▼鐩綍", "Thread folder"));
                ui.text_edit_singleline(&mut self.thread_form.folder);
                ui.label(self.tr("璇存槑", "Description"));
                ui.add(TextEdit::multiline(&mut self.thread_form.description).desired_rows(3));
                ui.horizontal(|ui| {
                    if ui.button(self.tr("鍒涘缓", "Create")).clicked() {
                        create = true;
                    }
                    if ui.button(self.tr("鍙栨秷", "Cancel")).clicked() {
                        cancel = true;
                    }
                });
            });
        self.show_thread_form = open;

        if create {
            self.add_thread_action();
        }
        if cancel {
            self.show_thread_form = false;
        }
    }

    fn render_chat_tab_v2(&mut self, ctx: &egui::Context) {
        egui::SidePanel::left("claw_gui_threads_v2")
            .resizable(true)
            .default_width(280.0)
            .min_width(230.0)
            .show(ctx, |ui| self.render_thread_tree_v2(ui));

        egui::SidePanel::right("claw_gui_inspector_v2")
            .resizable(true)
            .default_width(330.0)
            .min_width(280.0)
            .show(ctx, |ui| self.render_inspector_v2(ui));

        egui::CentralPanel::default().show(ctx, |ui| self.render_chat_stream_v2(ui));
    }
}

#[allow(dead_code)]
impl ClawGuiApp {
    fn render_thread_tree_v2(&mut self, ui: &mut egui::Ui) {
        let threads = self
            .agent_store
            .as_ref()
            .map(AgentWorkspaceStore::list_threads)
            .unwrap_or_default();
        let apps = self
            .agent_store
            .as_ref()
            .map(AgentWorkspaceStore::list_apps)
            .unwrap_or_default();
        let file_entries = collect_workspace_entries(&self.active_chat_workspace(), 1, 28);
        let skills = collect_skill_names(&self.workspace, 10);

        ScrollArea::vertical().auto_shrink([false, false]).show(ui, |ui| {
            section_card(ui, self.theme, self.tr("绾跨▼鏍", "Thread Tree"), |ui| {
                ui.horizontal(|ui| {
                    if ui.button(self.tr("鏂板缓绾跨▼", "New Thread")).clicked() {
                        self.show_thread_form = true;
                    }
                    if ui.button(self.tr("宸ヤ綔鍖鸿亰澶", "Workspace Chat")).clicked() {
                        self.select_workspace_chat();
                    }
                });

                let selected = self.active_thread_name.is_none();
                if ui
                    .selectable_label(selected, self.tr("褰撳墠宸ヤ綔鍖", "Current workspace"))
                    .clicked()
                {
                    self.select_workspace_chat();
                }
                ui.small(self.workspace.display().to_string());
                ui.separator();

                if threads.is_empty() {
                    ui.label(self.tr(
                        "杩樻病鏈変繚瀛樼殑绾跨▼銆傜偣鍑讳笂鏂规寜閽负涓嶅悓鏂囦欢澶瑰垱寤虹嫭绔嬪璇濄€?,
                        "No saved threads yet. Create one for each folder you want to isolate.",
                    ));
                } else {
                    let mut remove_name = None::<String>;
                    for thread in threads {
                        let selected = self.active_thread_name.as_deref() == Some(thread.name.as_str());
                        Frame::group(ui.style())
                            .fill(self.theme.subpanel_fill())
                            .stroke(Stroke::new(1.0, self.theme.accent().gamma_multiply(0.30)))
                            .show(ui, |ui| {
                                ui.horizontal(|ui| {
                                    if ui.selectable_label(selected, &thread.name).clicked() {
                                        self.activate_thread(&thread.name);
                                    }
                                    ui.with_layout(Layout::right_to_left(Align::Center), |ui| {
                                        if ui.small_button(self.tr("鍒犻櫎", "Remove")).clicked() {
                                            remove_name = Some(thread.name.clone());
                                        }
                                    });
                                });
                                if let Some(description) = &thread.description {
                                    if !description.trim().is_empty() {
                                        ui.small(description);
                                    }
                                }
                                ui.small(thread.folder);
                            });
                        ui.add_space(6.0);
                    }
                    if let Some(name) = remove_name {
                        self.remove_thread(&name);
                    }
                }
            });

            ui.add_space(10.0);

            section_card(ui, self.theme, self.tr("鏂囦欢鏍", "File Tree"), |ui| {
                if file_entries.is_empty() {
                    ui.label(self.tr("褰撳墠鐩綍涓嬫病鏈夊彲鏄剧ず鐨勬枃浠躲€", "No files to display."));
                } else {
                    for entry in file_entries {
                        ui.monospace(entry);
                    }
                }
            });

            ui.add_space(10.0);

            section_card(ui, self.theme, self.tr("鎶€鑳", "Skills"), |ui| {
                if skills.is_empty() {
                    ui.label(self.tr(
                        "鏆傛湭鍙戠幇宸插畨瑁呮妧鑳姐€傚彲浠ョ户缁娇鐢?CLI 鐨?/skills list 鍜?/skills install <path>銆?,
                        "No installed skills were detected. You can still use CLI /skills list and /skills install <path>.",
                    ));
                } else {
                    for skill in skills {
                        ui.label(RichText::new(skill).strong());
                    }
                }
                ui.small(self.tr(
                    "杩欓儴鍒嗗厛灞曠ず宸插彂鐜扮殑鎶€鑳藉悕绉帮紝鍚庣画鍙互缁х画鎺ュ叆瀹夎鍜屽惎鐢ㄥ姩浣溿€?,
                    "This area currently shows detected skill names. Install/enable actions can be added next.",
                ));
            });

            ui.add_space(10.0);

            section_card(ui, self.theme, self.tr("搴旂敤蹇嵎鍖", "App Shortcuts"), |ui| {
                if apps.is_empty() {
                    ui.label(self.tr(
                        "杩樻病鏈変繚瀛樼殑搴旂敤銆備綘鍙互鍦ㄢ€滃簲鐢ㄢ€濋〉淇濆瓨甯哥敤鍛戒护鍜岃鏄庛€?,
                        "No saved apps yet. Use the Apps tab to store reusable commands and notes.",
                    ));
                } else {
                    for app in apps.iter().take(6) {
                        ui.label(RichText::new(&app.name).strong());
                        ui.small(&app.description);
                        ui.monospace(&app.command);
                        ui.separator();
                    }
                }
                if ui.button(self.tr("鎵撳紑搴旂敤椤", "Open Apps tab")).clicked() {
                    self.active_tab = Tab::Apps;
                }
            });
        });
    }

    fn render_chat_stream_v2(&mut self, ui: &mut egui::Ui) {
        let messages = self.active_session.messages.clone();
        let estimated_input = estimate_text_tokens(&self.composer);
        let composer_hint = self
            .tr(
                "杈撳叆浠诲姟銆侀棶棰樻垨淇敼瑕佹眰銆傚杞笂涓嬫枃浼氫繚鐣欏湪褰撳墠绾跨▼閲屻€?,
                "Write a task, question, or edit request. Multi-turn context stays in the current thread.",
            )
            .to_string();
        let limits = self
            .llm_store
            .as_ref()
            .map_or_else(TurnTokenLimits::default, LlmProfileStore::turn_token_limits);

        section_card(ui, self.theme, &self.active_chat_title_clean(), |ui| {
            ui.horizontal_wrapped(|ui| {
                ui.label(format!(
                    "{}: {}",
                    self.tr("鐩綍", "Folder"),
                    self.active_chat_workspace().display()
                ));
                ui.separator();
                ui.label(format!(
                    "{}: {}",
                    self.tr("浼氳瘽", "Session"),
                    self.active_session.session_id
                ));
                ui.separator();
                ui.label(format!(
                    "{}: {}",
                    self.tr("娑堟伅鏁", "Messages"),
                    messages.len()
                ));
                if self.busy {
                    ui.separator();
                    ui.label(
                        RichText::new(self.tr("姝ｅ湪鐢熸垚涓€", "Generating..."))
                            .strong()
                            .color(self.theme.accent()),
                    );
                }
            });
        });

        ui.add_space(8.0);

        section_card(ui, self.theme, self.tr("瀵硅瘽娴", "Conversation"), |ui| {
            ScrollArea::vertical()
                .stick_to_bottom(true)
                .auto_shrink([false, false])
                .show(ui, |ui| {
                    if messages.is_empty()
                        && self.optimistic_user_prompt.is_none()
                        && self.live_reply.is_empty()
                    {
                        ui.add_space(24.0);
                        ui.vertical_centered(|ui| {
                            ui.label(
                                RichText::new(self.tr("寮€濮嬫柊鐨勫杞璇", "Start a new multi-turn chat"))
                                    .strong()
                                    .size(18.0),
                            );
                            ui.label(self.tr(
                                "宸﹁竟鍒囨崲绾跨▼鍜屾枃浠讹紝涓棿鑱婂ぉ锛屽彸杈规煡鐪嬪伐鍏蜂簨浠躲€乼oken 鍜岃垂鐢ㄣ€?,
                                "Switch threads and files on the left, chat in the center, inspect tools, tokens, and cost on the right.",
                            ));
                        });
                        ui.add_space(24.0);
                    }

                    for message in messages
                        .iter()
                        .filter(|message| message.role != MessageRole::System)
                    {
                        render_message_card_v2(ui, message, self.language, self.theme);
                        ui.add_space(8.0);
                    }

                    if let Some(prompt) = &self.optimistic_user_prompt {
                        let pending = ConversationMessage {
                            role: MessageRole::User,
                            blocks: vec![ContentBlock::Text { text: prompt.clone() }],
                            usage: None,
                        };
                        render_message_card_v2(ui, &pending, self.language, self.theme);
                        ui.add_space(8.0);
                    }

                    if !self.live_reply.is_empty() {
                        let streaming = ConversationMessage {
                            role: MessageRole::Assistant,
                            blocks: vec![ContentBlock::Text {
                                text: self.live_reply.clone(),
                            }],
                            usage: None,
                        };
                        render_message_card_v2(ui, &streaming, self.language, self.theme);
                    }
                });
        });

        ui.add_space(8.0);

        section_card(ui, self.theme, self.tr("杈撳叆鍖", "Composer"), |ui| {
            ui.horizontal_wrapped(|ui| {
                ui.label(format!(
                    "{}: {}",
                    self.tr("棰勮杈撳叆 token", "Estimated input tokens"),
                    estimated_input
                ));
                ui.separator();
                ui.label(format!(
                    "{}: {}",
                    self.tr("闄愰", "Limits"),
                    limits.summary_line()
                ));
                ui.separator();
                ui.label(self.tr("蹇嵎閿? Ctrl+Enter 鍙戦€", "Shortcut: Ctrl+Enter to send"));
            });

            ui.add(
                TextEdit::multiline(&mut self.composer)
                    .desired_rows(6)
                    .hint_text(composer_hint),
            );

            ui.horizontal(|ui| {
                if ui
                    .add_enabled(!self.busy, egui::Button::new(self.tr("鍙戦€", "Send")))
                    .clicked()
                {
                    self.send_current_prompt();
                }
                if ui.button(self.tr("娓呯┖鑽夌", "Clear draft")).clicked() {
                    self.composer.clear();
                }
                if ui.button(self.tr("妯″瀷椤", "Models")).clicked() {
                    self.active_tab = Tab::Models;
                }
            });
        });
    }

    fn render_inspector_v2(&mut self, ui: &mut egui::Ui) {
        section_card(ui, self.theme, self.tr("杩炴帴鐘舵€", "Connection"), |ui| {
            ui.label(format!(
                "{}: {}",
                self.tr("Profile", "Profile"),
                self.active_profile_name()
                    .unwrap_or_else(|| self.tr("(鏈縺娲", "(none)").to_string())
            ));
            ui.label(format!(
                "{}: {}",
                self.tr("Provider", "Provider"),
                self.active_provider_clean()
            ));
            ui.label(format!(
                "{}: {}",
                self.tr("Model", "Model"),
                self.active_model()
            ));
            ui.label(format!(
                "{}: {}",
                self.tr("Base URL", "Base URL"),
                self.active_base_url_clean()
            ));
        });

        ui.add_space(10.0);

        section_card(
            ui,
            self.theme,
            self.tr("Token 鐢ㄩ噺", "Token Usage"),
            |ui| {
                ui.label(format!(
                    "{}: {}",
                    self.tr("鏈疆杈撳叆", "Turn input"),
                    self.latest_turn_usage.input_tokens
                ));
                ui.label(format!(
                    "{}: {}",
                    self.tr("鏈疆杈撳嚭", "Turn output"),
                    self.latest_turn_usage.output_tokens
                ));
                ui.label(format!(
                    "{}: {}",
                    self.tr("鏈疆缂撳瓨鍐欏叆", "Turn cache write"),
                    self.latest_turn_usage.cache_creation_input_tokens
                ));
                ui.label(format!(
                    "{}: {}",
                    self.tr("鏈疆缂撳瓨璇诲彇", "Turn cache read"),
                    self.latest_turn_usage.cache_read_input_tokens
                ));
                ui.separator();
                ui.label(format!(
                    "{}: {}",
                    self.tr("鏈疆鎬婚噺", "Turn total"),
                    token_total(self.latest_turn_usage)
                ));
                ui.label(format!(
                    "{}: {}",
                    self.tr("浼氳瘽绱", "Session total"),
                    token_total(self.cumulative_usage)
                ));
            },
        );

        ui.add_space(10.0);

        section_card(
            ui,
            self.theme,
            self.tr("璐圭敤浼扮畻", "Cost Estimate"),
            |ui| {
                ui.label(format!(
                    "{}: {}",
                    self.tr("鏈疆璐圭敤", "Turn cost"),
                    self.session_cost_label_clean(self.latest_turn_usage)
                ));
                ui.label(format!(
                    "{}: {}",
                    self.tr("浼氳瘽璐圭敤", "Session cost"),
                    self.session_cost_label_clean(self.cumulative_usage)
                ));
            },
        );

        ui.add_space(10.0);

        section_card(
            ui,
            self.theme,
            self.tr("宸ュ叿浜嬩欢", "Tool Events"),
            |ui| {
                ScrollArea::vertical()
                    .auto_shrink([false, false])
                    .show(ui, |ui| {
                        if self.inspector_events.is_empty() {
                            ui.label(self.tr(
                        "鏈疆杩樻病鏈夊伐鍏蜂簨浠躲€傛ā鍨嬭皟鐢?read/edit/bash/search 绛夊伐鍏峰悗浼氭樉绀哄湪杩欓噷銆?,
                        "No tool events yet. Calls like read/edit/bash/search will appear here.",
                    ));
                        } else {
                            for event in &self.inspector_events {
                                let color = if event.is_error {
                                    Color32::from_rgb(179, 60, 60)
                                } else {
                                    self.theme.accent()
                                };
                                Frame::group(ui.style())
                                    .fill(self.theme.subpanel_fill())
                                    .stroke(Stroke::new(1.0, color.gamma_multiply(0.35)))
                                    .show(ui, |ui| {
                                        ui.label(RichText::new(&event.title).strong().color(color));
                                        ui.label(&event.body);
                                    });
                                ui.add_space(6.0);
                            }
                        }
                    });
            },
        );
    }
}

#[allow(dead_code)]
impl ClawGuiApp {
    fn render_models_tab_v2(&mut self, ctx: &egui::Context) {
        let profiles = self
            .llm_store
            .as_ref()
            .map(LlmProfileStore::list_profiles)
            .unwrap_or_default();
        let env_label = self.tr("鐜鍙橀噺", "Env var").to_string();
        let inline_label = self.tr("鐩存帴濉叆", "Inline key").to_string();
        let limits_summary = self
            .llm_store
            .as_ref()
            .map_or_else(TurnTokenLimits::default, LlmProfileStore::turn_token_limits)
            .summary_line();

        egui::CentralPanel::default().show(ctx, |ui| {
            ui.columns(2, |columns| {
                section_card(&mut columns[0], self.theme, self.tr("LLM Profile 缂栬緫", "LLM Profile Editor"), |ui| {
                    ui.label(self.tr("鍚嶇О", "Name"));
                    ui.text_edit_singleline(&mut self.llm_form.name);
                    ui.label(self.tr("Provider", "Provider"));
                    ui.text_edit_singleline(&mut self.llm_form.provider);
                    ui.label(self.tr("Model", "Model"));
                    ui.text_edit_singleline(&mut self.llm_form.model);
                    ui.label(self.tr("Base URL", "Base URL"));
                    ui.text_edit_singleline(&mut self.llm_form.base_url);
                    let inline_key_label = self.tr("鐩存帴濉叆 Key", "Inline key");
                    let env_key_label = self.tr("鐜鍙橀噺", "Env var");
                    let mut key_from_env = self.llm_key_from_env;

                    ui.horizontal(|ui| {
                        ui.selectable_value(&mut self.llm_key_from_env, true, env_label.as_str());
                        ui.selectable_value(&mut self.llm_key_from_env, false, inline_label.as_str());
                    });

                    if self.llm_key_from_env {
                        ui.label(self.tr("API Key 鐜鍙橀噺", "API key environment variable"));
                        ui.text_edit_singleline(&mut self.llm_form.api_key_env);
                    } else {
                        ui.label(self.tr("API Key", "API key"));
                        ui.add(TextEdit::singleline(&mut self.llm_form.api_key).password(true));
                    }

                    ui.horizontal(|ui| {
                        if ui.button(self.tr("淇濆瓨", "Save")).clicked() {
                            self.save_profile_action();
                        }
                        if ui.button(self.tr("淇濆瓨骞舵縺娲", "Save + Activate")).clicked() {
                            let profile_name = self.llm_form.name.trim().to_string();
                            if self.save_profile_action() {
                                self.switch_profile_action(Some(&profile_name));
                            }
                        }
                        if ui.button(self.tr("娓呯┖琛ㄥ崟", "Clear form")).clicked() {
                            self.llm_form = LlmForm::default();
                            self.llm_key_from_env = false;
                        }
                    });
                });

                section_card(&mut columns[1], self.theme, self.tr("宸蹭繚瀛樼殑 Profiles", "Saved Profiles"), |ui| {
                    ui.label(format!("{}: {}", self.tr("褰撳墠闄愰", "Current limits"), limits_summary));
                    ui.add_space(4.0);
                    if profiles.is_empty() {
                        ui.label(self.tr(
                            "杩樻病鏈?profile銆傚缓璁厛淇濆瓨涓€涓?deepseek / qwen / kimi / glm / openai 鍏煎閰嶇疆銆?,
                            "No profiles yet. Save a deepseek / qwen / kimi / glm / openai-compatible profile first.",
                        ));
                    } else {
                        for profile in profiles {
                            let active = self.active_profile_name().as_deref() == Some(profile.name.as_str());
                            Frame::group(ui.style())
                                .fill(self.theme.subpanel_fill())
                                .stroke(Stroke::new(1.0, self.theme.accent().gamma_multiply(0.30)))
                                .show(ui, |ui| {
                                    ui.horizontal_wrapped(|ui| {
                                        ui.label(RichText::new(&profile.name).strong().color(if active { self.theme.accent() } else { ui.visuals().text_color() }));
                                        if active {
                                            ui.label(self.tr("褰撳墠婵€娲", "Active"));
                                        }
                                    });
                                    ui.small(format!("provider={} model={}", profile.normalized_provider(), profile.model));
                                    if let Some(base_url) = &profile.base_url {
                                        if !base_url.trim().is_empty() {
                                            ui.small(base_url);
                                        }
                                    }
                                    ui.small(profile.key_source_label());
                                    ui.horizontal(|ui| {
                                        if ui.button(self.tr("缂栬緫", "Edit")).clicked() {
                                            self.load_profile_into_form(&profile);
                                        }
                                        if ui.button(self.tr("婵€娲", "Activate")).clicked() {
                                            self.switch_profile_action(Some(&profile.name));
                                        }
                                        if ui.button(self.tr("鍒犻櫎", "Remove")).clicked() {
                                            self.remove_profile(&profile.name);
                                        }
                                    });
                                });
                            ui.add_space(6.0);
                        }
                    }
                });
            });

            ui.add_space(12.0);
            section_card(ui, self.theme, self.tr("姣忚疆 Token 闄愰", "Per-turn Token Limits"), |ui| {
                ui.columns(4, |columns| {
                    columns[0].label(self.tr("鏈€灏忚緭鍏", "Min input"));
                    columns[0].text_edit_singleline(&mut self.limits_form.min_input);
                    columns[1].label(self.tr("鏈€澶ц緭鍏", "Max input"));
                    columns[1].text_edit_singleline(&mut self.limits_form.max_input);
                    columns[2].label(self.tr("鏈€灏忚緭鍑", "Min output"));
                    columns[2].text_edit_singleline(&mut self.limits_form.min_output);
                    columns[3].label(self.tr("鏈€澶ц緭鍑", "Max output"));
                    columns[3].text_edit_singleline(&mut self.limits_form.max_output);
                });
                ui.horizontal(|ui| {
                    if ui.button(self.tr("淇濆瓨闄愰", "Save limits")).clicked() {
                        self.save_limits_action();
                    }
                    if ui.button(self.tr("娓呯┖闄愰", "Clear limits")).clicked() {
                        self.limits_form = LimitsForm::default();
                    }
                });
            });
        });
    }

    fn render_apps_tab_v2(&mut self, ctx: &egui::Context) {
        let apps = self
            .agent_store
            .as_ref()
            .map(AgentWorkspaceStore::list_apps)
            .unwrap_or_default();

        egui::CentralPanel::default().show(ctx, |ui| {
            ui.columns(2, |columns| {
                section_card(
                    &mut columns[0],
                    self.theme,
                    self.tr("淇濆瓨搴旂敤鍛戒护", "Save App Command"),
                    |ui| {
                        ui.label(self.tr("鍚嶇О", "Name"));
                        ui.text_edit_singleline(&mut self.app_form.name);
                        ui.label(self.tr("鍛戒护", "Command"));
                        ui.text_edit_singleline(&mut self.app_form.command);
                        ui.label(self.tr("璇存槑", "Description"));
                        ui.add(TextEdit::multiline(&mut self.app_form.description).desired_rows(4));
                        ui.horizontal(|ui| {
                            if ui.button(self.tr("淇濆瓨搴旂敤", "Save app")).clicked() {
                                self.save_app_action();
                            }
                            if ui.button(self.tr("娓呯┖琛ㄥ崟", "Clear form")).clicked() {
                                self.app_form = AppForm::default();
                            }
                        });
                    },
                );

                section_card(
                    &mut columns[1],
                    self.theme,
                    self.tr("宸蹭繚瀛樼殑搴旂敤", "Saved Apps"),
                    |ui| {
                        if apps.is_empty() {
                            ui.label(self.tr("杩樻病鏈変繚瀛樼殑搴旂敤銆", "No saved apps yet."));
                        } else {
                            for app in apps {
                                Frame::group(ui.style())
                                    .fill(self.theme.subpanel_fill())
                                    .stroke(Stroke::new(
                                        1.0,
                                        self.theme.accent().gamma_multiply(0.30),
                                    ))
                                    .show(ui, |ui| {
                                        ui.label(RichText::new(&app.name).strong());
                                        ui.small(&app.description);
                                        ui.monospace(&app.command);
                                        ui.horizontal(|ui| {
                                            if ui
                                                .button(self.tr("瑁呭叆琛ㄥ崟", "Load into form"))
                                                .clicked()
                                            {
                                                self.app_form = AppForm {
                                                    name: app.name.clone(),
                                                    command: app.command.clone(),
                                                    description: app.description.clone(),
                                                };
                                            }
                                            if ui.button(self.tr("鍒犻櫎", "Remove")).clicked() {
                                                self.remove_app(&app.name);
                                            }
                                        });
                                    });
                                ui.add_space(6.0);
                            }
                        }
                    },
                );
            });
        });
    }

    fn render_sessions_tab_v2(&mut self, ctx: &egui::Context) {
        let sessions = self.sessions.clone();
        egui::CentralPanel::default().show(ctx, |ui| {
            section_card(
                ui,
                self.theme,
                self.tr("宸ヤ綔鍖轰細璇", "Workspace Sessions"),
                |ui| {
                    ui.horizontal(|ui| {
                        if ui.button(self.tr("鍒锋柊", "Refresh")).clicked() {
                            self.refresh_session_list();
                        }
                        ui.label(format!("{}: {}", self.tr("鎬绘暟", "Total"), sessions.len()));
                    });

                    if sessions.is_empty() {
                        ui.label(self.tr(
                            "褰撳墠宸ヤ綔鍖鸿繕娌℃湁淇濆瓨浼氳瘽銆?,
                            "No saved sessions in this workspace yet.",
                        ));
                        return;
                    }

                    ScrollArea::vertical()
                        .auto_shrink([false, false])
                        .show(ui, |ui| {
                            for summary in sessions {
                                let active = self.active_session_path == summary.path;
                                Frame::group(ui.style())
                                    .fill(self.theme.subpanel_fill())
                                    .stroke(Stroke::new(
                                        1.0,
                                        self.theme.accent().gamma_multiply(0.30),
                                    ))
                                    .show(ui, |ui| {
                                        ui.horizontal_wrapped(|ui| {
                                            ui.label(RichText::new(&summary.id).strong().color(
                                                if active {
                                                    self.theme.accent()
                                                } else {
                                                    ui.visuals().text_color()
                                                },
                                            ));
                                            if active {
                                                ui.label(self.tr("褰撳墠浼氳瘽", "Current session"));
                                            }
                                        });
                                        ui.small(format!(
                                            "{}: {}",
                                            self.tr("娑堟伅鏁", "Messages"),
                                            summary.message_count
                                        ));
                                        if let Some(parent) = &summary.parent_session_id {
                                            ui.small(format!(
                                                "{}: {}",
                                                self.tr("鐖朵細璇", "Parent"),
                                                parent
                                            ));
                                        }
                                        if let Some(branch) = &summary.branch_name {
                                            ui.small(format!(
                                                "{}: {}",
                                                self.tr("鍒嗘敮", "Branch"),
                                                branch
                                            ));
                                        }
                                        ui.small(summary.path.display().to_string());
                                        ui.horizontal(|ui| {
                                            if ui
                                                .button(self.tr("杞藉叆鍒拌亰澶", "Load into chat"))
                                                .clicked()
                                            {
                                                self.load_session_summary_action(&summary);
                                            }
                                        });
                                    });
                                ui.add_space(8.0);
                            }
                        });
                },
            );
        });
    }
}

impl ClawGuiApp {
    fn render_top_bar_v3(&mut self, ctx: &egui::Context) {
        egui::TopBottomPanel::top("claw_gui_top_bar_v3").show(ctx, |ui| {
            ui.add_space(6.0);
            ui.horizontal(|ui| {
                ui.label(
                    RichText::new("Claw Client")
                        .strong()
                        .size(22.0)
                        .color(self.theme.accent()),
                );
                ui.label(
                    RichText::new(self.tr(
                        "鎺ヨ繎 Codex 妗岄潰绔殑澶氭ā鍨嬪伐浣滃彴",
                        "A multi-model workspace inspired by Codex Desktop",
                    ))
                    .small(),
                );
                ui.with_layout(Layout::right_to_left(Align::Center), |ui| {
                    if ui.button(self.tr("甯姪", "Help")).clicked() {
                        self.show_help = true;
                    }

                    ComboBox::from_id_salt("gui_theme_v3")
                        .selected_text(theme_label(self.theme, self.language))
                        .show_ui(ui, |ui| {
                            for theme in UiTheme::all() {
                                ui.selectable_value(
                                    &mut self.theme,
                                    theme,
                                    theme_label(theme, self.language),
                                );
                            }
                        });

                    ComboBox::from_id_salt("gui_lang_v3")
                        .selected_text(language_label(self.language))
                        .show_ui(ui, |ui| {
                            ui.selectable_value(&mut self.language, Language::Zh, "涓枃");
                            ui.selectable_value(&mut self.language, Language::En, "English");
                        });
                });
            });

            ui.horizontal_wrapped(|ui| {
                for tab in Tab::all() {
                    let selected = self.active_tab == tab;
                    if ui
                        .selectable_label(selected, tab_label(tab, self.language))
                        .clicked()
                    {
                        self.active_tab = tab;
                    }
                }
            });

            ui.horizontal(|ui| {
                ui.label(self.tr("宸ヤ綔鍖", "Workspace"));
                let input_width = (ui.available_width() - 300.0).max(180.0);
                let response = ui.add_sized(
                    [input_width, 28.0],
                    TextEdit::singleline(&mut self.workspace_input),
                );
                if response.lost_focus() && ui.input(|input| input.key_pressed(egui::Key::Enter)) {
                    self.reload();
                }
                if ui.button(self.tr("鍔犺浇", "Load")).clicked() {
                    self.reload();
                }
                if ui.button(self.tr("宸ヤ綔鍖鸿亰澶", "Workspace Chat")).clicked() {
                    self.select_workspace_chat();
                }
                if ui.button(self.tr("浼氳瘽", "Sessions")).clicked() {
                    self.active_tab = Tab::Sessions;
                }
            });

            ui.horizontal_wrapped(|ui| {
                ui.label(format!(
                    "{}: {}",
                    self.tr("妯″瀷", "Model"),
                    self.active_model()
                ));
                ui.separator();
                ui.label(format!(
                    "{}: {}",
                    self.tr("Provider", "Provider"),
                    self.active_provider_clean()
                ));
                ui.separator();
                ui.label(format!(
                    "{}: {}",
                    self.tr("Base URL", "Base URL"),
                    self.active_base_url_clean()
                ));
                ui.separator();
                ui.label(format!(
                    "{}: {}",
                    self.tr("褰撳墠绾跨▼", "Current thread"),
                    self.active_chat_title_clean()
                ));
            });

            if let Some(error) = &self.error {
                ui.colored_label(Color32::from_rgb(180, 48, 48), error);
            } else if let Some(notice) = &self.notice {
                ui.colored_label(self.theme.accent(), notice);
            }

            ui.add_space(4.0);
        });
    }

    fn render_help_window_v3(&mut self, ctx: &egui::Context) {
        if !self.show_help {
            return;
        }

        let title = self.tr("甯姪涓庤鏄", "Help & Notes").to_string();
        let mut open = self.show_help;
        egui::Window::new(title)
            .open(&mut open)
            .default_width(620.0)
            .show(ctx, |ui| {
                ui.label(self.tr(
                    "杩欐槸涓€涓潰鍚戝妯″瀷缂栫▼ Agent 鐨勬闈?GUI銆傚乏渚х鐞嗙嚎绋嬪拰涓婁笅鏂囷紝涓棿杩涜澶氳疆鑱婂ぉ锛屽彸渚ф煡鐪嬪伐鍏蜂簨浠躲€乀oken 鍜岃垂鐢ㄣ€?,
                    "This desktop GUI is built for multi-model coding agents. Use the left side for threads and context, the center for chat, and the right side for tool events, tokens, and cost.",
                ));
                ui.add_space(8.0);
                ui.separator();
                ui.add_space(8.0);

                ui.label(
                    RichText::new(self.tr("鎺ㄨ崘娴佺▼", "Recommended flow"))
                        .strong()
                        .color(self.theme.accent()),
                );
                ui.label(self.tr(
                    "1. 鍏堝湪鈥滄ā鍨嬧€濋〉淇濆瓨骞舵縺娲讳竴涓?LLM Profile銆?,
                    "1. Start in Models and save an LLM profile, then activate it.",
                ));
                ui.label(self.tr(
                    "2. 鍦ㄥ乏渚у垱寤虹嚎绋嬶紝鎶婁笉鍚岄」鐩洰褰曞垎寮€绠＄悊銆?,
                    "2. Create threads on the left so different folders keep separate context.",
                ));
                ui.label(self.tr(
                    "3. 鍦ㄤ腑闂磋亰澶╁尯鎸佺画澶氳疆瀵硅瘽锛汣trl+Enter 鍙洿鎺ュ彂閫併€?,
                    "3. Keep chatting in the center panel; press Ctrl+Enter to send.",
                ));
                ui.label(self.tr(
                    "4. 鍙充晶 Inspector 浼氭樉绀哄綋鍓嶈繛鎺ャ€乀oken銆佷汉姘戝竵鎴栫編鍏冭垂鐢紝浠ュ強宸ュ叿璋冪敤浜嬩欢銆?,
                    "4. The right inspector shows connection info, token usage, RMB or USD cost, and tool events.",
                ));
                ui.label(self.tr(
                    "5. 鈥滃簲鐢ㄢ€濋〉閫傚悎淇濆瓨甯哥敤鍛戒护璇存槑锛涒€滀細璇濃€濋〉閫傚悎鍥炵湅鍜屽垏鎹㈠巻鍙蹭細璇濄€?,
                    "5. Use Apps for reusable command notes and Sessions for loading saved workspace sessions.",
                ));
            });
        self.show_help = open;
    }

    fn render_thread_window_v3(&mut self, ctx: &egui::Context) {
        if !self.show_thread_form {
            return;
        }

        let title = self.tr("鍒涘缓绾跨▼", "Create Thread").to_string();
        let mut create = false;
        let mut cancel = false;
        let mut open = self.show_thread_form;

        egui::Window::new(title)
            .open(&mut open)
            .collapsible(false)
            .resizable(false)
            .default_width(440.0)
            .show(ctx, |ui| {
                ui.label(self.tr("绾跨▼鍚嶇О", "Thread name"));
                ui.text_edit_singleline(&mut self.thread_form.name);
                ui.label(self.tr("绾跨▼鐩綍", "Thread folder"));
                ui.text_edit_singleline(&mut self.thread_form.folder);
                ui.label(self.tr("璇存槑", "Description"));
                ui.add(TextEdit::multiline(&mut self.thread_form.description).desired_rows(3));
                ui.horizontal(|ui| {
                    if ui.button(self.tr("鍒涘缓", "Create")).clicked() {
                        create = true;
                    }
                    if ui.button(self.tr("鍙栨秷", "Cancel")).clicked() {
                        cancel = true;
                    }
                });
            });
        self.show_thread_form = open;

        if create {
            self.add_thread_action();
        }
        if cancel {
            self.show_thread_form = false;
        }
    }

    fn render_chat_tab_v3(&mut self, ctx: &egui::Context) {
        egui::SidePanel::left("claw_gui_threads_v3")
            .resizable(true)
            .default_width(300.0)
            .min_width(240.0)
            .show(ctx, |ui| self.render_thread_tree_v3(ui));

        egui::SidePanel::right("claw_gui_inspector_v3")
            .resizable(true)
            .default_width(340.0)
            .min_width(285.0)
            .show(ctx, |ui| self.render_inspector_v3(ui));

        egui::CentralPanel::default().show(ctx, |ui| self.render_chat_stream_v5(ui));
    }
}

impl ClawGuiApp {
    fn render_thread_tree_v3(&mut self, ui: &mut egui::Ui) {
        let threads = self
            .agent_store
            .as_ref()
            .map(AgentWorkspaceStore::list_threads)
            .unwrap_or_default();
        let apps = self
            .agent_store
            .as_ref()
            .map(AgentWorkspaceStore::list_apps)
            .unwrap_or_default();
        let file_entries = collect_workspace_entries(&self.active_chat_workspace(), 1, 28);
        let skills = collect_skill_names(&self.workspace, 10);

        ScrollArea::vertical().auto_shrink([false, false]).show(ui, |ui| {
            section_card(ui, self.theme, self.tr("绾跨▼", "Threads"), |ui| {
                ui.horizontal(|ui| {
                    if ui.button(self.tr("鏂扮嚎绋", "New Thread")).clicked() {
                        self.show_thread_form = true;
                    }
                    if ui.button(self.tr("宸ヤ綔鍖鸿亰澶", "Workspace Chat")).clicked() {
                        self.select_workspace_chat();
                    }
                    if ui.button(self.tr("浼氳瘽椤", "Sessions")).clicked() {
                        self.active_tab = Tab::Sessions;
                    }
                });

                let selected = self.active_thread_name.is_none();
                if ui
                    .selectable_label(selected, self.tr("褰撳墠宸ヤ綔鍖", "Current workspace"))
                    .clicked()
                {
                    self.select_workspace_chat();
                }
                ui.small(self.workspace.display().to_string());
                ui.separator();

                if threads.is_empty() {
                    ui.label(self.tr(
                        "杩樻病鏈夊凡淇濆瓨鐨勭嚎绋嬨€備负姣忎釜椤圭洰鐩綍鍒涘缓鐙珛绾跨▼锛岃亰澶╀笂涓嬫枃浼氬垎鍒繚瀛樸€?,
                        "No saved threads yet. Create a separate thread for each project folder.",
                    ));
                } else {
                    let mut remove_name = None::<String>;
                    for thread in threads {
                        let selected =
                            self.active_thread_name.as_deref() == Some(thread.name.as_str());
                        Frame::group(ui.style())
                            .fill(self.theme.subpanel_fill())
                            .stroke(Stroke::new(1.0, self.theme.accent().gamma_multiply(0.30)))
                            .show(ui, |ui| {
                                ui.horizontal(|ui| {
                                    if ui.selectable_label(selected, &thread.name).clicked() {
                                        self.activate_thread(&thread.name);
                                    }
                                    ui.with_layout(Layout::right_to_left(Align::Center), |ui| {
                                        if ui.small_button(self.tr("鍒犻櫎", "Remove")).clicked() {
                                            remove_name = Some(thread.name.clone());
                                        }
                                    });
                                });
                                if let Some(description) = &thread.description {
                                    if !description.trim().is_empty() {
                                        ui.small(description);
                                    }
                                }
                                ui.small(thread.folder);
                            });
                        ui.add_space(6.0);
                    }
                    if let Some(name) = remove_name {
                        self.remove_thread(&name);
                    }
                }
            });

            ui.add_space(10.0);

            section_card(ui, self.theme, self.tr("鏂囦欢鏍", "File Tree"), |ui| {
                if file_entries.is_empty() {
                    ui.label(self.tr("褰撳墠鐩綍涓嬫病鏈夊彲鏄剧ず鐨勬枃浠躲€", "No files to display."));
                } else {
                    for entry in file_entries {
                        ui.monospace(entry);
                    }
                }
            });

            ui.add_space(10.0);

            section_card(ui, self.theme, self.tr("鎶€鑳", "Skills"), |ui| {
                if skills.is_empty() {
                    ui.label(self.tr(
                        "鏆傛湭鍙戠幇宸插畨瑁呮妧鑳姐€傚悗缁彲浠ョ户缁帴鍏ュ畨瑁呭拰鍚敤鎿嶄綔銆?,
                        "No installed skills detected yet. Install and enable actions can be added next.",
                    ));
                } else {
                    for skill in skills {
                        ui.label(RichText::new(skill).strong());
                    }
                }
            });

            ui.add_space(10.0);

            section_card(ui, self.theme, self.tr("搴旂敤蹇嵎鏂瑰紡", "App Shortcuts"), |ui| {
                if apps.is_empty() {
                    ui.label(self.tr(
                        "杩樻病鏈夊凡淇濆瓨鐨勫簲鐢ㄣ€備綘鍙互鍦ㄢ€滃簲鐢ㄢ€濋〉淇濆瓨甯哥敤鍛戒护鍜屾搷浣滆鏄庛€?,
                        "No saved apps yet. Use the Apps tab to store reusable commands and notes.",
                    ));
                } else {
                    for app in apps.iter().take(6) {
                        ui.label(RichText::new(&app.name).strong());
                        ui.small(&app.description);
                        ui.monospace(&app.command);
                        ui.separator();
                    }
                }
                if ui.button(self.tr("鎵撳紑搴旂敤椤", "Open Apps tab")).clicked() {
                    self.active_tab = Tab::Apps;
                }
            });
        });
    }

    fn render_chat_stream_v3(&mut self, ui: &mut egui::Ui) {
        let messages = self.active_session.messages.clone();
        let estimated_input = estimate_text_tokens(&self.composer);
        let limits = self
            .llm_store
            .as_ref()
            .map_or_else(TurnTokenLimits::default, LlmProfileStore::turn_token_limits);
        let composer_hint = self
            .tr(
                "杈撳叆浠诲姟銆侀棶棰樻垨淇敼璇锋眰銆傚綋鍓嶇嚎绋嬩細淇濈暀澶氳疆涓婁笅鏂囥€?,
                "Write a task, question, or edit request. Multi-turn context stays in the current thread.",
            )
            .to_string();

        section_card(ui, self.theme, &self.active_chat_title_clean(), |ui| {
            ui.horizontal_wrapped(|ui| {
                ui.label(format!(
                    "{}: {}",
                    self.tr("鐩綍", "Folder"),
                    self.active_chat_workspace().display()
                ));
                ui.separator();
                ui.label(format!(
                    "{}: {}",
                    self.tr("浼氳瘽", "Session"),
                    self.active_session.session_id
                ));
                ui.separator();
                ui.label(format!(
                    "{}: {}",
                    self.tr("娑堟伅鏁", "Messages"),
                    messages.len()
                ));
                if self.busy {
                    ui.separator();
                    ui.label(
                        RichText::new(self.tr("鐢熸垚涓?..", "Generating..."))
                            .strong()
                            .color(self.theme.accent()),
                    );
                }
            });

            ui.add_space(6.0);
            ui.horizontal_wrapped(|ui| {
                if ui.button(self.tr("鏂扮嚎绋", "New Thread")).clicked() {
                    self.show_thread_form = true;
                }
                if ui.button(self.tr("宸ヤ綔鍖鸿亰澶", "Workspace Chat")).clicked() {
                    self.select_workspace_chat();
                }
                if ui.button(self.tr("妯″瀷椤", "Models")).clicked() {
                    self.active_tab = Tab::Models;
                }
                if ui.button(self.tr("浼氳瘽椤", "Sessions")).clicked() {
                    self.active_tab = Tab::Sessions;
                }
            });
        });

        ui.add_space(8.0);

        section_card(ui, self.theme, self.tr("瀵硅瘽娴", "Conversation"), |ui| {
            ScrollArea::vertical()
                .stick_to_bottom(true)
                .auto_shrink([false, false])
                .show(ui, |ui| {
                    if messages.is_empty()
                        && self.optimistic_user_prompt.is_none()
                        && self.live_reply.is_empty()
                    {
                        ui.add_space(26.0);
                        ui.vertical_centered(|ui| {
                            ui.label(
                                RichText::new(self.tr("寮€濮嬫柊鐨勫杞亰澶", "Start a new multi-turn chat"))
                                    .strong()
                                    .size(18.0),
                            );
                            ui.label(self.tr(
                                "宸︿晶鍒囩嚎绋嬪拰涓婁笅鏂囷紝涓棿鎸佺画瀵硅瘽锛屽彸渚х湅宸ュ叿浜嬩欢銆乀oken 鍜岃垂鐢ㄣ€?,
                                "Switch threads and context on the left, chat in the center, and inspect tools, tokens, and cost on the right.",
                            ));
                            ui.add_space(10.0);
                            ui.horizontal_wrapped(|ui| {
                                if ui.button(self.tr("鍒涘缓绾跨▼", "Create Thread")).clicked() {
                                    self.show_thread_form = true;
                                }
                                if ui.button(self.tr("閰嶇疆妯″瀷", "Configure Model")).clicked() {
                                    self.active_tab = Tab::Models;
                                }
                                if ui.button(self.tr("鏌ョ湅浼氳瘽", "Open Sessions")).clicked() {
                                    self.active_tab = Tab::Sessions;
                                }
                            });
                        });
                        ui.add_space(26.0);
                    }

                    for message in messages
                        .iter()
                        .filter(|message| message.role != MessageRole::System)
                    {
                        render_message_card_v3(ui, message, self.language, self.theme);
                        ui.add_space(8.0);
                    }

                    if let Some(prompt) = &self.optimistic_user_prompt {
                        let pending = ConversationMessage {
                            role: MessageRole::User,
                            blocks: vec![ContentBlock::Text { text: prompt.clone() }],
                            usage: None,
                        };
                        render_message_card_v3(ui, &pending, self.language, self.theme);
                        ui.add_space(8.0);
                    }

                    if !self.live_reply.is_empty() {
                        let streaming = ConversationMessage {
                            role: MessageRole::Assistant,
                            blocks: vec![ContentBlock::Text {
                                text: self.live_reply.clone(),
                            }],
                            usage: None,
                        };
                        render_message_card_v3(ui, &streaming, self.language, self.theme);
                    }
                });
        });

        ui.add_space(8.0);

        section_card(ui, self.theme, self.tr("杈撳叆鍖", "Composer"), |ui| {
            ui.horizontal_wrapped(|ui| {
                ui.label(format!(
                    "{}: {}",
                    self.tr("棰勪及杈撳叆 Token", "Estimated input tokens"),
                    estimated_input
                ));
                ui.separator();
                ui.label(format!(
                    "{}: {}",
                    self.tr("闄愰", "Limits"),
                    limits.summary_line()
                ));
                ui.separator();
                ui.label(format!(
                    "{}: {}",
                    self.tr("Profile", "Profile"),
                    self.active_profile_name()
                        .unwrap_or_else(|| self.tr("(鏈縺娲", "(none)").to_string())
                ));
                ui.separator();
                ui.label(self.tr("蹇嵎閿? Ctrl+Enter 鍙戦€", "Shortcut: Ctrl+Enter to send"));
            });

            ui.add(
                TextEdit::multiline(&mut self.composer)
                    .desired_rows(6)
                    .hint_text(composer_hint),
            );

            ui.horizontal(|ui| {
                if ui
                    .add_enabled(!self.busy, egui::Button::new(self.tr("鍙戦€", "Send")))
                    .clicked()
                {
                    self.send_current_prompt();
                }
                if ui.button(self.tr("娓呯┖鑽夌", "Clear draft")).clicked() {
                    self.composer.clear();
                }
                if ui.button(self.tr("妯″瀷椤", "Models")).clicked() {
                    self.active_tab = Tab::Models;
                }
                if ui.button(self.tr("浼氳瘽椤", "Sessions")).clicked() {
                    self.active_tab = Tab::Sessions;
                }
            });
        });
    }

    fn render_chat_stream_v4(&mut self, ui: &mut egui::Ui) {
        let messages = self.active_session.messages.clone();
        let estimated_input = estimate_text_tokens(&self.composer);
        let limits = self
            .llm_store
            .as_ref()
            .map_or_else(TurnTokenLimits::default, LlmProfileStore::turn_token_limits);
        let composer_hint = self
            .tr(
                "杈撳叆浠诲姟銆侀棶棰樻垨淇敼璇锋眰銆傚綋鍓嶇嚎绋嬩細淇濈暀澶氳疆涓婁笅鏂囥€?,
                "Write a task, question, or edit request. Multi-turn context stays in the current thread.",
            )
            .to_string();

        section_card(ui, self.theme, &self.active_chat_title_clean(), |ui| {
            ui.horizontal_wrapped(|ui| {
                ui.label(format!(
                    "{}: {}",
                    self.tr("鐩綍", "Folder"),
                    self.active_chat_workspace().display()
                ));
                ui.separator();
                ui.label(format!(
                    "{}: {}",
                    self.tr("浼氳瘽", "Session"),
                    self.active_session.session_id
                ));
                ui.separator();
                ui.label(format!(
                    "{}: {}",
                    self.tr("娑堟伅鏁", "Messages"),
                    messages.len()
                ));
                if self.busy {
                    ui.separator();
                    ui.label(
                        RichText::new(self.tr("鐢熸垚涓?..", "Generating..."))
                            .strong()
                            .color(self.theme.accent()),
                    );
                }
            });

            ui.add_space(6.0);
            ui.horizontal_wrapped(|ui| {
                if ui.button(self.tr("鏂扮嚎绋", "New Thread")).clicked() {
                    self.show_thread_form = true;
                }
                if ui.button(self.tr("宸ヤ綔鍖鸿亰澶", "Workspace Chat")).clicked() {
                    self.select_workspace_chat();
                }
                if ui.button(self.tr("妯″瀷椤", "Models")).clicked() {
                    self.active_tab = Tab::Models;
                }
                if ui.button(self.tr("浼氳瘽椤", "Sessions")).clicked() {
                    self.active_tab = Tab::Sessions;
                }
            });
        });

        ui.add_space(8.0);

        let composer_height = 190.0;
        let conversation_height = (ui.available_height() - composer_height - 8.0).max(220.0);

        ui.allocate_ui_with_layout(
            egui::vec2(ui.available_width(), conversation_height),
            Layout::top_down(Align::Min),
            |ui| {
                section_card(ui, self.theme, self.tr("瀵硅瘽娴", "Conversation"), |ui| {
                    ui.set_min_height((conversation_height - 16.0).max(180.0));
                    ScrollArea::vertical()
                        .stick_to_bottom(true)
                        .auto_shrink([false, false])
                        .show(ui, |ui| {
                            if messages.is_empty()
                                && self.optimistic_user_prompt.is_none()
                                && self.live_reply.is_empty()
                            {
                                ui.add_space(26.0);
                                ui.vertical_centered(|ui| {
                                    ui.label(
                                        RichText::new(self.tr(
                                            "寮€濮嬫柊鐨勫杞亰澶?,
                                            "Start a new multi-turn chat",
                                        ))
                                        .strong()
                                        .size(18.0),
                                    );
                                    ui.label(self.tr(
                                        "宸︿晶鍒囩嚎绋嬪拰涓婁笅鏂囷紝涓棿鎸佺画瀵硅瘽锛屽彸渚х湅宸ュ叿浜嬩欢銆乀oken 鍜岃垂鐢ㄣ€?,
                                        "Switch threads and context on the left, chat in the center, and inspect tools, tokens, and cost on the right.",
                                    ));
                                    ui.add_space(10.0);
                                    ui.horizontal_wrapped(|ui| {
                                        if ui.button(self.tr("鍒涘缓绾跨▼", "Create Thread")).clicked()
                                        {
                                            self.show_thread_form = true;
                                        }
                                        if ui.button(self.tr("閰嶇疆妯″瀷", "Configure Model")).clicked()
                                        {
                                            self.active_tab = Tab::Models;
                                        }
                                        if ui.button(self.tr("鏌ョ湅浼氳瘽", "Open Sessions")).clicked()
                                        {
                                            self.active_tab = Tab::Sessions;
                                        }
                                    });
                                });
                                ui.add_space(26.0);
                            }

                            for message in messages
                                .iter()
                                .filter(|message| message.role != MessageRole::System)
                            {
                                render_message_card_v3(ui, message, self.language, self.theme);
                                ui.add_space(8.0);
                            }

                            if let Some(prompt) = &self.optimistic_user_prompt {
                                let pending = ConversationMessage {
                                    role: MessageRole::User,
                                    blocks: vec![ContentBlock::Text { text: prompt.clone() }],
                                    usage: None,
                                };
                                render_message_card_v3(ui, &pending, self.language, self.theme);
                                ui.add_space(8.0);
                            }

                            if !self.live_reply.is_empty() {
                                let streaming = ConversationMessage {
                                    role: MessageRole::Assistant,
                                    blocks: vec![ContentBlock::Text {
                                        text: self.live_reply.clone(),
                                    }],
                                    usage: None,
                                };
                                render_message_card_v3(ui, &streaming, self.language, self.theme);
                            }

                            if !self.inspector_events.is_empty() {
                                ui.add_space(8.0);
                                for event in self.inspector_events.iter().rev().take(8).rev() {
                                    render_tool_event_card_v1(ui, event, self.language, self.theme);
                                    ui.add_space(6.0);
                                }
                            }
                        });
                });
            },
        );

        ui.add_space(8.0);

        section_card(ui, self.theme, self.tr("杈撳叆鍖", "Composer"), |ui| {
            ui.horizontal_wrapped(|ui| {
                ui.label(format!(
                    "{}: {}",
                    self.tr("棰勪及杈撳叆 Token", "Estimated input tokens"),
                    estimated_input
                ));
                ui.separator();
                ui.label(format!(
                    "{}: {}",
                    self.tr("闄愰", "Limits"),
                    limits.summary_line()
                ));
                ui.separator();
                ui.label(format!(
                    "{}: {}",
                    self.tr("Profile", "Profile"),
                    self.active_profile_name()
                        .unwrap_or_else(|| self.tr("(鏈縺娲", "(none)").to_string())
                ));
                ui.separator();
                ui.label(self.tr("蹇嵎閿? Ctrl+Enter 鍙戦€", "Shortcut: Ctrl+Enter to send"));
            });

            ui.add(
                TextEdit::multiline(&mut self.composer)
                    .desired_rows(6)
                    .hint_text(composer_hint),
            );

            ui.horizontal(|ui| {
                if ui
                    .add_enabled(!self.busy, egui::Button::new(self.tr("鍙戦€", "Send")))
                    .clicked()
                {
                    self.send_current_prompt();
                }
                if ui.button(self.tr("娓呯┖鑽夌", "Clear draft")).clicked() {
                    self.composer.clear();
                }
                if ui.button(self.tr("妯″瀷椤", "Models")).clicked() {
                    self.active_tab = Tab::Models;
                }
                if ui.button(self.tr("浼氳瘽椤", "Sessions")).clicked() {
                    self.active_tab = Tab::Sessions;
                }
            });
        });
    }

    fn render_inspector_v3(&mut self, ui: &mut egui::Ui) {
        section_card(ui, self.theme, self.tr("鐘舵€", "Status"), |ui| {
            ui.label(format!(
                "{}: {}",
                self.tr("绾跨▼", "Thread"),
                self.active_chat_title_clean()
            ));
            ui.label(format!(
                "{}: {}",
                self.tr("浼氳瘽", "Session"),
                self.active_session.session_id
            ));
            ui.label(format!(
                "{}: {}",
                self.tr("娑堟伅鏁", "Messages"),
                self.active_session.messages.len()
            ));
            ui.label(format!(
                "{}: {}",
                self.tr("杩愯鐘舵€", "Run state"),
                self.tr(
                    if self.busy { "鐢熸垚涓? } else { "绌洪棽" },
                    if self.busy { "Running" } else { "Idle" },
                )
            ));
        });

        ui.add_space(10.0);

        section_card(ui, self.theme, self.tr("褰撳墠杩炴帴", "Connection"), |ui| {
            ui.label(format!(
                "{}: {}",
                self.tr("Profile", "Profile"),
                self.active_profile_name()
                    .unwrap_or_else(|| self.tr("(鏈縺娲", "(none)").to_string())
            ));
            ui.label(format!(
                "{}: {}",
                self.tr("Provider", "Provider"),
                self.active_provider_clean()
            ));
            ui.label(format!(
                "{}: {}",
                self.tr("Model", "Model"),
                self.active_model()
            ));
            ui.label(format!(
                "{}: {}",
                self.tr("Base URL", "Base URL"),
                self.active_base_url_clean()
            ));
        });

        ui.add_space(10.0);

        section_card(
            ui,
            self.theme,
            self.tr("Token 鐢ㄩ噺", "Token Usage"),
            |ui| {
                ui.label(format!(
                    "{}: {}",
                    self.tr("鏈疆杈撳叆", "Turn input"),
                    self.latest_turn_usage.input_tokens
                ));
                ui.label(format!(
                    "{}: {}",
                    self.tr("鏈疆杈撳嚭", "Turn output"),
                    self.latest_turn_usage.output_tokens
                ));
                ui.label(format!(
                    "{}: {}",
                    self.tr("鏈疆缂撳瓨鍐欏叆", "Turn cache write"),
                    self.latest_turn_usage.cache_creation_input_tokens
                ));
                ui.label(format!(
                    "{}: {}",
                    self.tr("鏈疆缂撳瓨璇诲彇", "Turn cache read"),
                    self.latest_turn_usage.cache_read_input_tokens
                ));
                ui.separator();
                ui.label(format!(
                    "{}: {}",
                    self.tr("鏈疆鎬婚噺", "Turn total"),
                    token_total(self.latest_turn_usage)
                ));
                ui.label(format!(
                    "{}: {}",
                    self.tr("浼氳瘽绱", "Session total"),
                    token_total(self.cumulative_usage)
                ));
            },
        );

        ui.add_space(10.0);

        section_card(
            ui,
            self.theme,
            self.tr("璐圭敤浼扮畻", "Cost Estimate"),
            |ui| {
                ui.label(format!(
                    "{}: {}",
                    self.tr("鏈疆璐圭敤", "Turn cost"),
                    self.session_cost_label_clean(self.latest_turn_usage)
                ));
                ui.label(format!(
                    "{}: {}",
                    self.tr("浼氳瘽璐圭敤", "Session cost"),
                    self.session_cost_label_clean(self.cumulative_usage)
                ));
                ui.small(self.tr(
                "涓浗鍘傚晢妯″瀷浼樺厛鎸変汉姘戝竵瀹樻柟鍗曚环浼扮畻锛屽叾瀹冩ā鍨嬫寜宸查厤缃环鏍艰〃鎴栭粯璁よ揣甯佷及绠椼€?,
                "Chinese-provider models prefer RMB official pricing. Other models use the configured or default price table.",
            ));
            },
        );

        ui.add_space(10.0);

        section_card(
            ui,
            self.theme,
            self.tr("宸ュ叿浜嬩欢", "Tool Events"),
            |ui| {
                ScrollArea::vertical()
                .auto_shrink([false, false])
                .show(ui, |ui| {
                    if self.inspector_events.is_empty() {
                        ui.label(self.tr(
                            "鏈疆杩樻病鏈夊伐鍏蜂簨浠躲€傝皟鐢?read / edit / bash / search 绛夊伐鍏峰悗浼氭樉绀哄湪杩欓噷銆?,
                            "No tool events yet. Calls like read / edit / bash / search will appear here.",
                        ));
                    } else {
                        for event in &self.inspector_events {
                            let color = if event.is_error {
                                Color32::from_rgb(179, 60, 60)
                            } else {
                                self.theme.accent()
                            };
                            Frame::group(ui.style())
                                .fill(self.theme.subpanel_fill())
                                .stroke(Stroke::new(1.0, color.gamma_multiply(0.35)))
                                .show(ui, |ui| {
                                    ui.label(RichText::new(&event.title).strong().color(color));
                                    ui.label(&event.body);
                                });
                            ui.add_space(6.0);
                        }
                    }
                });
            },
        );
    }
}

impl ClawGuiApp {
    fn render_models_tab_v3(&mut self, ctx: &egui::Context) {
        let profiles = self
            .llm_store
            .as_ref()
            .map(LlmProfileStore::list_profiles)
            .unwrap_or_default();
        let env_label = self.tr("鐜鍙橀噺", "Env var").to_string();
        let inline_label = self.tr("鐩存帴濉叆", "Inline key").to_string();
        let limits_summary = self
            .llm_store
            .as_ref()
            .map_or_else(TurnTokenLimits::default, LlmProfileStore::turn_token_limits)
            .summary_line();

        egui::CentralPanel::default().show(ctx, |ui| {
            ui.columns(2, |columns| {
                section_card(
                    &mut columns[0],
                    self.theme,
                    self.tr("LLM Profile 缂栬緫", "LLM Profile Editor"),
                    |ui| {
                        ui.label(self.tr("鍚嶇О", "Name"));
                        ui.text_edit_singleline(&mut self.llm_form.name);
                        ui.label(self.tr("Provider", "Provider"));
                        ui.text_edit_singleline(&mut self.llm_form.provider);
                        ui.label(self.tr("Model", "Model"));
                        ui.text_edit_singleline(&mut self.llm_form.model);
                        ui.label(self.tr("Base URL", "Base URL"));
                        ui.text_edit_singleline(&mut self.llm_form.base_url);

                        ui.horizontal(|ui| {
                            ui.selectable_value(&mut self.llm_key_from_env, true, env_label.as_str());
                            ui.selectable_value(
                                &mut self.llm_key_from_env,
                                false,
                                inline_label.as_str(),
                            );
                        });

                        if self.llm_key_from_env {
                            ui.label(self.tr("API Key 鐜鍙橀噺", "API key environment variable"));
                            ui.text_edit_singleline(&mut self.llm_form.api_key_env);
                        } else {
                            ui.label(self.tr("API Key", "API key"));
                            ui.add(TextEdit::singleline(&mut self.llm_form.api_key).password(true));
                        }

                        ui.horizontal(|ui| {
                            if ui.button(self.tr("淇濆瓨", "Save")).clicked() {
                                self.save_profile_action();
                            }
                            if ui.button(self.tr("淇濆瓨骞舵縺娲", "Save + Activate")).clicked() {
                                let profile_name = self.llm_form.name.trim().to_string();
                                if self.save_profile_action() {
                                    self.switch_profile_action(Some(&profile_name));
                                }
                            }
                            if ui.button(self.tr("娓呯┖琛ㄥ崟", "Clear form")).clicked() {
                                self.llm_form = LlmForm::default();
                                self.llm_key_from_env = false;
                            }
                        });
                    },
                );

                section_card(
                    &mut columns[1],
                    self.theme,
                    self.tr("宸蹭繚瀛樼殑 Profiles", "Saved Profiles"),
                    |ui| {
                        ui.label(format!(
                            "{}: {}",
                            self.tr("褰撳墠闄愰", "Current limits"),
                            limits_summary
                        ));
                        ui.add_space(4.0);
                        if profiles.is_empty() {
                            ui.label(self.tr(
                                "杩樻病鏈?profile銆傚缓璁厛淇濆瓨涓€涓?deepseek / qwen / kimi / glm / openai 鍏煎閰嶇疆銆?,
                                "No profiles yet. Save a deepseek / qwen / kimi / glm / openai-compatible profile first.",
                            ));
                        } else {
                            for profile in profiles {
                                let active =
                                    self.active_profile_name().as_deref() == Some(profile.name.as_str());
                                Frame::group(ui.style())
                                    .fill(self.theme.subpanel_fill())
                                    .stroke(Stroke::new(
                                        1.0,
                                        self.theme.accent().gamma_multiply(0.30),
                                    ))
                                    .show(ui, |ui| {
                                        ui.horizontal_wrapped(|ui| {
                                            ui.label(
                                                RichText::new(&profile.name)
                                                    .strong()
                                                    .color(if active {
                                                        self.theme.accent()
                                                    } else {
                                                        ui.visuals().text_color()
                                                    }),
                                            );
                                            if active {
                                                ui.label(self.tr("褰撳墠婵€娲", "Active"));
                                            }
                                        });
                                        ui.small(format!(
                                            "provider={} model={}",
                                            profile.normalized_provider(),
                                            profile.model
                                        ));
                                        if let Some(base_url) = &profile.base_url {
                                            if !base_url.trim().is_empty() {
                                                ui.small(base_url);
                                            }
                                        }
                                        ui.small(profile.key_source_label());
                                        ui.horizontal(|ui| {
                                            if ui.button(self.tr("缂栬緫", "Edit")).clicked() {
                                                self.load_profile_into_form(&profile);
                                            }
                                            if ui.button(self.tr("婵€娲", "Activate")).clicked() {
                                                self.switch_profile_action(Some(&profile.name));
                                            }
                                            if ui.button(self.tr("鍒犻櫎", "Remove")).clicked() {
                                                self.remove_profile(&profile.name);
                                            }
                                        });
                                    });
                                ui.add_space(6.0);
                            }
                        }
                    },
                );
            });

            ui.add_space(12.0);
            section_card(ui, self.theme, self.tr("姣忚疆 Token 闄愰", "Per-turn Token Limits"), |ui| {
                ui.columns(4, |columns| {
                    columns[0].label(self.tr("鏈€灏忚緭鍏", "Min input"));
                    columns[0].text_edit_singleline(&mut self.limits_form.min_input);
                    columns[1].label(self.tr("鏈€澶ц緭鍏", "Max input"));
                    columns[1].text_edit_singleline(&mut self.limits_form.max_input);
                    columns[2].label(self.tr("鏈€灏忚緭鍑", "Min output"));
                    columns[2].text_edit_singleline(&mut self.limits_form.min_output);
                    columns[3].label(self.tr("鏈€澶ц緭鍑", "Max output"));
                    columns[3].text_edit_singleline(&mut self.limits_form.max_output);
                });
                ui.horizontal(|ui| {
                    if ui.button(self.tr("淇濆瓨闄愰", "Save limits")).clicked() {
                        self.save_limits_action();
                    }
                    if ui.button(self.tr("娓呯┖闄愰", "Clear limits")).clicked() {
                        self.limits_form = LimitsForm::default();
                    }
                });
                ui.small(self.tr(
                    "涓浗鍘傚晢妯″瀷浼氫紭鍏堟寜浜烘皯甯佸畼鏂瑰崟浠蜂及绠楄垂鐢紝骞跺湪姣忚疆鍥炵瓟鍚庢樉绀鸿垂鐢ㄣ€?,
                    "Chinese-provider models prefer RMB official pricing and show cost after each turn.",
                ));
            });
        });
    }

    fn render_apps_tab_v3(&mut self, ctx: &egui::Context) {
        let apps = self
            .agent_store
            .as_ref()
            .map(AgentWorkspaceStore::list_apps)
            .unwrap_or_default();

        egui::CentralPanel::default().show(ctx, |ui| {
            ui.columns(2, |columns| {
                section_card(
                    &mut columns[0],
                    self.theme,
                    self.tr("淇濆瓨搴旂敤鍛戒护", "Save App Command"),
                    |ui| {
                        ui.label(self.tr("鍚嶇О", "Name"));
                        ui.text_edit_singleline(&mut self.app_form.name);
                        ui.label(self.tr("鍛戒护", "Command"));
                        ui.text_edit_singleline(&mut self.app_form.command);
                        ui.label(self.tr("璇存槑", "Description"));
                        ui.add(TextEdit::multiline(&mut self.app_form.description).desired_rows(4));
                        ui.horizontal(|ui| {
                            if ui.button(self.tr("淇濆瓨搴旂敤", "Save app")).clicked() {
                                self.save_app_action();
                            }
                            if ui.button(self.tr("娓呯┖琛ㄥ崟", "Clear form")).clicked() {
                                self.app_form = AppForm::default();
                            }
                        });
                    },
                );

                section_card(
                    &mut columns[1],
                    self.theme,
                    self.tr("宸蹭繚瀛樼殑搴旂敤", "Saved Apps"),
                    |ui| {
                        if apps.is_empty() {
                            ui.label(self.tr(
                                "杩樻病鏈夊凡淇濆瓨鐨勫簲鐢ㄣ€傝繖閲岄€傚悎鏀惧父鐢ㄥ懡浠ゃ€佸惎鍔ㄨ剼鏈拰鎿嶄綔璇存槑銆?,
                                "No saved apps yet. This area is good for reusable commands and notes.",
                            ));
                        } else {
                            for app in apps {
                                Frame::group(ui.style())
                                    .fill(self.theme.subpanel_fill())
                                    .stroke(Stroke::new(
                                        1.0,
                                        self.theme.accent().gamma_multiply(0.30),
                                    ))
                                    .show(ui, |ui| {
                                        ui.label(RichText::new(&app.name).strong());
                                        ui.small(&app.description);
                                        ui.monospace(&app.command);
                                        ui.horizontal(|ui| {
                                            if ui
                                                .button(self.tr("杞藉叆琛ㄥ崟", "Load into form"))
                                                .clicked()
                                            {
                                                self.app_form = AppForm {
                                                    name: app.name.clone(),
                                                    command: app.command.clone(),
                                                    description: app.description.clone(),
                                                };
                                            }
                                            if ui.button(self.tr("鍒犻櫎", "Remove")).clicked() {
                                                self.remove_app(&app.name);
                                            }
                                        });
                                    });
                                ui.add_space(6.0);
                            }
                        }
                    },
                );
            });
        });
    }

    fn render_sessions_tab_v3(&mut self, ctx: &egui::Context) {
        let sessions = self.sessions.clone();
        egui::CentralPanel::default().show(ctx, |ui| {
            section_card(
                ui,
                self.theme,
                self.tr("宸ヤ綔鍖轰細璇", "Workspace Sessions"),
                |ui| {
                    ui.horizontal(|ui| {
                        if ui.button(self.tr("鍒锋柊", "Refresh")).clicked() {
                            self.refresh_session_list();
                        }
                        ui.label(format!("{}: {}", self.tr("鎬绘暟", "Total"), sessions.len()));
                    });

                    if sessions.is_empty() {
                        ui.label(self.tr(
                            "褰撳墠宸ヤ綔鍖鸿繕娌℃湁宸蹭繚瀛樹細璇濄€?,
                            "No saved sessions in this workspace yet.",
                        ));
                        return;
                    }

                    ScrollArea::vertical()
                        .auto_shrink([false, false])
                        .show(ui, |ui| {
                            for summary in sessions {
                                let active = self.active_session_path == summary.path;
                                Frame::group(ui.style())
                                    .fill(self.theme.subpanel_fill())
                                    .stroke(Stroke::new(
                                        1.0,
                                        self.theme.accent().gamma_multiply(0.30),
                                    ))
                                    .show(ui, |ui| {
                                        ui.horizontal_wrapped(|ui| {
                                            ui.label(RichText::new(&summary.id).strong().color(
                                                if active {
                                                    self.theme.accent()
                                                } else {
                                                    ui.visuals().text_color()
                                                },
                                            ));
                                            if active {
                                                ui.label(self.tr("褰撳墠浼氳瘽", "Current session"));
                                            }
                                        });
                                        ui.small(format!(
                                            "{}: {}",
                                            self.tr("娑堟伅鏁", "Messages"),
                                            summary.message_count
                                        ));
                                        if let Some(parent) = &summary.parent_session_id {
                                            ui.small(format!(
                                                "{}: {}",
                                                self.tr("鐖朵細璇", "Parent"),
                                                parent
                                            ));
                                        }
                                        if let Some(branch) = &summary.branch_name {
                                            ui.small(format!(
                                                "{}: {}",
                                                self.tr("鍒嗘敮", "Branch"),
                                                branch
                                            ));
                                        }
                                        ui.small(summary.path.display().to_string());
                                        ui.horizontal(|ui| {
                                            if ui
                                                .button(self.tr("杞藉叆鍒拌亰澶", "Load into chat"))
                                                .clicked()
                                            {
                                                self.load_session_summary_action(&summary);
                                            }
                                        });
                                    });
                                ui.add_space(8.0);
                            }
                        });
                },
            );
        });
    }
}

impl ClawGuiApp {
    fn render_chat_stream_v5(&mut self, ui: &mut egui::Ui) {
        let messages = self.active_session.messages.clone();
        let estimated_input = estimate_text_tokens(&self.composer);
        let limits = self
            .llm_store
            .as_ref()
            .map_or_else(TurnTokenLimits::default, LlmProfileStore::turn_token_limits);
        let profiles = self
            .llm_store
            .as_ref()
            .map(LlmProfileStore::list_profiles)
            .unwrap_or_default();
        let composer_hint = self
            .tr(
                "杈撳叆浠诲姟銆侀棶棰樻垨淇敼璇锋眰銆傚綋鍓嶇嚎绋嬩細淇濈暀澶氳疆涓婁笅鏂囥€?,
                "Write a task, question, or edit request. Multi-turn context stays in the current thread.",
            )
            .to_string();

        section_card(ui, self.theme, &self.active_chat_title_clean(), |ui| {
            ui.horizontal_wrapped(|ui| {
                ui.label(format!(
                    "{}: {}",
                    self.tr("鐩綍", "Folder"),
                    self.active_chat_workspace().display()
                ));
                ui.separator();
                ui.label(format!(
                    "{}: {}",
                    self.tr("浼氳瘽", "Session"),
                    self.active_session.session_id
                ));
                ui.separator();
                ui.label(format!(
                    "{}: {}",
                    self.tr("娑堟伅鏁", "Messages"),
                    messages.len()
                ));
                if self.busy {
                    ui.separator();
                    ui.label(
                        RichText::new(self.tr("鐢熸垚涓?..", "Generating..."))
                            .strong()
                            .color(self.theme.accent()),
                    );
                }
            });

            let current_profile = self
                .active_profile_name()
                .unwrap_or_else(|| self.tr("(鏈縺娲", "(none)").to_string());
            let mut selected_profile = self.active_profile_name().unwrap_or_default();

            ui.add_space(6.0);
            ui.horizontal_wrapped(|ui| {
                ui.label(format!(
                    "{}: {}",
                    self.tr("褰撳墠妯″瀷", "Active profile"),
                    current_profile
                ));
                if !profiles.is_empty() {
                    ComboBox::from_id_salt("chat_profile_switch_v5")
                        .selected_text(if selected_profile.is_empty() {
                            self.tr("(鏈縺娲", "(none)")
                        } else {
                            selected_profile.as_str()
                        })
                        .show_ui(ui, |ui| {
                            ui.selectable_value(
                                &mut selected_profile,
                                String::new(),
                                self.tr("(鏈縺娲", "(none)"),
                            );
                            for profile in &profiles {
                                ui.selectable_value(
                                    &mut selected_profile,
                                    profile.name.clone(),
                                    &profile.name,
                                );
                            }
                        });
                }
                if ui.button(self.tr("妯″瀷椤", "Models")).clicked() {
                    self.active_tab = Tab::Models;
                }
                if ui.button(self.tr("鏂扮嚎绋", "New Thread")).clicked() {
                    self.show_thread_form = true;
                }
            });

            let current_name = self.active_profile_name().unwrap_or_default();
            if current_name != selected_profile {
                if selected_profile.trim().is_empty() {
                    self.switch_profile_action(None);
                } else {
                    self.switch_profile_action(Some(&selected_profile));
                }
            }
        });

        ui.add_space(8.0);

        let composer_height = 210.0;
        let conversation_height = (ui.available_height() - composer_height - 8.0).max(220.0);

        ui.allocate_ui_with_layout(
            egui::vec2(ui.available_width(), conversation_height),
            Layout::top_down(Align::Min),
            |ui| {
                section_card(ui, self.theme, self.tr("瀵硅瘽娴", "Conversation"), |ui| {
                    ui.set_min_height((conversation_height - 16.0).max(180.0));
                    ScrollArea::vertical()
                        .stick_to_bottom(true)
                        .auto_shrink([false, false])
                        .show(ui, |ui| {
                            if messages.is_empty()
                                && self.optimistic_user_prompt.is_none()
                                && self.live_reply.is_empty()
                            {
                                ui.add_space(26.0);
                                ui.vertical_centered(|ui| {
                                    ui.label(
                                        RichText::new(self.tr(
                                            "寮€濮嬫柊鐨勫杞亰澶?,
                                            "Start a new multi-turn chat",
                                        ))
                                        .strong()
                                        .size(18.0),
                                    );
                                    ui.label(self.tr(
                                        "鍏堝湪鈥滄ā鍨嬧€濋〉淇濆瓨涓€涓甫 API Key 鐨?Profile锛屾垨鑰呭湪涓婃柟涓嬫媺妗嗗垏鎹㈠埌宸插鍏ユā鍨嬶紝鐒跺悗灏卞彲浠ョ洿鎺ヨ亰澶┿€?,
                                        "Save a profile with an API key in Models, or switch to an imported profile from the dropdown above, then start chatting.",
                                    ));
                                });
                                ui.add_space(26.0);
                            }

                            for message in messages
                                .iter()
                                .filter(|message| message.role != MessageRole::System)
                            {
                                render_message_card_v3(ui, message, self.language, self.theme);
                                ui.add_space(8.0);
                            }

                            if let Some(prompt) = &self.optimistic_user_prompt {
                                let pending = ConversationMessage {
                                    role: MessageRole::User,
                                    blocks: vec![ContentBlock::Text { text: prompt.clone() }],
                                    usage: None,
                                };
                                render_message_card_v3(ui, &pending, self.language, self.theme);
                                ui.add_space(8.0);
                            }

                            if !self.live_reply.is_empty() {
                                let streaming = ConversationMessage {
                                    role: MessageRole::Assistant,
                                    blocks: vec![ContentBlock::Text {
                                        text: self.live_reply.clone(),
                                    }],
                                    usage: None,
                                };
                                render_message_card_v3(ui, &streaming, self.language, self.theme);
                            }
                        });
                });
            },
        );

        ui.add_space(8.0);

        section_card(ui, self.theme, self.tr("杈撳叆鍖", "Composer"), |ui| {
            ui.horizontal_wrapped(|ui| {
                ui.label(format!(
                    "{}: {}",
                    self.tr("棰勪及杈撳叆 Token", "Estimated input tokens"),
                    estimated_input
                ));
                ui.separator();
                ui.label(format!(
                    "{}: {}",
                    self.tr("闄愰", "Limits"),
                    limits.summary_line()
                ));
                ui.separator();
                ui.label(format!(
                    "{}: {}",
                    self.tr("Profile", "Profile"),
                    self.active_profile_name()
                        .unwrap_or_else(|| self.tr("(鏈縺娲", "(none)").to_string())
                ));
                ui.separator();
                ui.label(self.tr("蹇嵎閿? Ctrl+Enter 鍙戦€", "Shortcut: Ctrl+Enter to send"));
            });

            ui.add(
                TextEdit::multiline(&mut self.composer)
                    .desired_rows(6)
                    .hint_text(composer_hint),
            );

            ui.horizontal(|ui| {
                if ui
                    .add_enabled(!self.busy, egui::Button::new(self.tr("鍙戦€", "Send")))
                    .clicked()
                {
                    self.send_current_prompt();
                }
                if ui.button(self.tr("娓呯┖鑽夌", "Clear draft")).clicked() {
                    self.composer.clear();
                }
                if ui.button(self.tr("宸ヤ綔鍖鸿亰澶", "Workspace Chat")).clicked() {
                    self.select_workspace_chat();
                }
                if ui.button(self.tr("浼氳瘽椤", "Sessions")).clicked() {
                    self.active_tab = Tab::Sessions;
                }
            });
        });
    }

    fn render_models_tab_v4(&mut self, ctx: &egui::Context) {
        let profiles = self
            .llm_store
            .as_ref()
            .map(LlmProfileStore::list_profiles)
            .unwrap_or_default();
        let env_label = self.tr("鐜鍙橀噺", "Env var").to_string();
        let inline_label = self.tr("鐩存帴濉叆 Key", "Inline key").to_string();
        let limits_summary = self
            .llm_store
            .as_ref()
            .map_or_else(TurnTokenLimits::default, LlmProfileStore::turn_token_limits)
            .summary_line();

        egui::CentralPanel::default().show(ctx, |ui| {
            ui.columns(2, |columns| {
                section_card(
                    &mut columns[0],
                    self.theme,
                    self.tr("妯″瀷閰嶇疆", "Model Profile"),
                    |ui| {
                        ui.label(self.tr("鍚嶇О", "Name"));
                        ui.text_edit_singleline(&mut self.llm_form.name);
                        ui.label(self.tr("Provider", "Provider"));
                        ui.text_edit_singleline(&mut self.llm_form.provider);
                        ui.label(self.tr("Model", "Model"));
                        ui.text_edit_singleline(&mut self.llm_form.model);
                        ui.label(self.tr("Base URL", "Base URL"));
                        ui.text_edit_singleline(&mut self.llm_form.base_url);

                        ui.horizontal(|ui| {
                            ui.selectable_value(&mut self.llm_key_from_env, false, inline_label.as_str());
                            ui.selectable_value(&mut self.llm_key_from_env, true, env_label.as_str());
                        });

                        if self.llm_key_from_env {
                            ui.label(self.tr("API Key 鐜鍙橀噺鍚", "API key environment variable"));
                            ui.text_edit_singleline(&mut self.llm_form.api_key_env);
                        } else {
                            ui.label(self.tr("API Key", "API key"));
                            ui.add(TextEdit::singleline(&mut self.llm_form.api_key).password(true));
                        }

                        ui.small(self.tr(
                            "濡傛灉浣犳兂瀹屽叏閫氳繃 GUI 浣跨敤妯″瀷锛屾帹鑽愰€夋嫨鈥滅洿鎺ュ～鍏?Key鈥濄€備繚瀛樺苟婵€娲诲悗锛岃亰澶╅〉浼氱洿鎺ヨ皟鐢ㄨ繖涓ā鍨嬨€?,
                            "If you want to work entirely from the GUI, choose Inline key. After Save + Activate, the chat page will use this model directly.",
                        ));

                        ui.horizontal(|ui| {
                            if ui.button(self.tr("淇濆瓨", "Save")).clicked() {
                                self.save_profile_action();
                            }
                            if ui.button(self.tr("淇濆瓨骞舵縺娲", "Save + Activate")).clicked() {
                                let profile_name = self.llm_form.name.trim().to_string();
                                if self.save_profile_action() {
                                    self.switch_profile_action(Some(&profile_name));
                                }
                            }
                            if ui.button(self.tr("娓呯┖琛ㄥ崟", "Clear form")).clicked() {
                                self.llm_form = LlmForm::default();
                                self.llm_key_from_env = false;
                            }
                        });
                    },
                );

                section_card(
                    &mut columns[1],
                    self.theme,
                    self.tr("宸插鍏ユā鍨", "Imported Profiles"),
                    |ui| {
                        ui.label(format!(
                            "{}: {}",
                            self.tr("褰撳墠闄愰", "Current limits"),
                            limits_summary
                        ));
                        ui.add_space(4.0);

                        if profiles.is_empty() {
                            ui.label(self.tr(
                                "杩樻病鏈夊凡淇濆瓨妯″瀷銆傚厛鍦ㄥ乏渚у～鍏ュ悕绉般€丳rovider銆丮odel 鍜?API Key锛岀劧鍚庣偣鈥滀繚瀛樺苟婵€娲烩€濄€?,
                                "No saved profiles yet. Fill in name, provider, model, and API key on the left, then click Save + Activate.",
                            ));
                        } else {
                            let mut remove_name = None::<String>;
                            let mut activate_name = None::<String>;
                            let mut edit_profile = None::<LlmProfile>;

                            for profile in profiles {
                                let active =
                                    self.active_profile_name().as_deref() == Some(profile.name.as_str());
                                Frame::group(ui.style())
                                    .fill(self.theme.subpanel_fill())
                                    .stroke(Stroke::new(
                                        1.0,
                                        self.theme.accent().gamma_multiply(0.30),
                                    ))
                                    .show(ui, |ui| {
                                        ui.horizontal_wrapped(|ui| {
                                            ui.label(
                                                RichText::new(&profile.name)
                                                    .strong()
                                                    .color(if active {
                                                        self.theme.accent()
                                                    } else {
                                                        ui.visuals().text_color()
                                                    }),
                                            );
                                            if active {
                                                ui.label(self.tr("褰撳墠婵€娲", "Active"));
                                            }
                                        });
                                        ui.small(format!(
                                            "provider={} model={}",
                                            profile.normalized_provider(),
                                            profile.model
                                        ));
                                        if let Some(base_url) = &profile.base_url {
                                            if !base_url.trim().is_empty() {
                                                ui.small(base_url);
                                            }
                                        }
                                        ui.small(format!(
                                            "{}: {}",
                                            self.tr("Key 鏉ユ簮", "Key source"),
                                            profile.key_source_label()
                                        ));
                                        ui.small(format!(
                                            "{}: {}",
                                            self.tr("Key 棰勮", "Key preview"),
                                            profile.masked_key_preview()
                                        ));
                                        ui.horizontal(|ui| {
                                            if ui.button(self.tr("缂栬緫", "Edit")).clicked() {
                                                edit_profile = Some(profile.clone());
                                            }
                                            if ui.button(self.tr("婵€娲", "Activate")).clicked() {
                                                activate_name = Some(profile.name.clone());
                                            }
                                            if ui.button(self.tr("鍒犻櫎", "Remove")).clicked() {
                                                remove_name = Some(profile.name.clone());
                                            }
                                        });
                                    });
                                ui.add_space(6.0);
                            }

                            if let Some(profile) = edit_profile {
                                self.load_profile_into_form(&profile);
                            }
                            if let Some(name) = activate_name {
                                self.switch_profile_action(Some(&name));
                            }
                            if let Some(name) = remove_name {
                                self.remove_profile(&name);
                            }
                        }
                    },
                );
            });

            ui.add_space(12.0);
            section_card(ui, self.theme, self.tr("姣忚疆 Token 闄愰", "Per-turn Token Limits"), |ui| {
                ui.columns(4, |columns| {
                    columns[0].label(self.tr("鏈€灏忚緭鍏", "Min input"));
                    columns[0].text_edit_singleline(&mut self.limits_form.min_input);
                    columns[1].label(self.tr("鏈€澶ц緭鍏", "Max input"));
                    columns[1].text_edit_singleline(&mut self.limits_form.max_input);
                    columns[2].label(self.tr("鏈€灏忚緭鍑", "Min output"));
                    columns[2].text_edit_singleline(&mut self.limits_form.min_output);
                    columns[3].label(self.tr("鏈€澶ц緭鍑", "Max output"));
                    columns[3].text_edit_singleline(&mut self.limits_form.max_output);
                });

                ui.horizontal(|ui| {
                    if ui.button(self.tr("淇濆瓨闄愰", "Save limits")).clicked() {
                        self.save_limits_action();
                    }
                    if ui.button(self.tr("娓呯┖闄愰", "Clear limits")).clicked() {
                        self.limits_form = LimitsForm::default();
                    }
                });
            });
        });
    }
}

impl ClawGuiApp {
    fn render_thread_window_v4(&mut self, ctx: &egui::Context) {
        if !self.show_thread_form {
            return;
        }

        let mut open = self.show_thread_form;
        let mut create = false;
        let mut pick_folder = false;
        let mut cancel = false;

        egui::Window::new(self.tr("鏂板缓绾跨▼", "Create Thread"))
            .open(&mut open)
            .collapsible(false)
            .resizable(false)
            .default_width(460.0)
            .show(ctx, |ui| {
                ui.label(self.tr("绾跨▼鍚嶇О", "Thread name"));
                ui.text_edit_singleline(&mut self.thread_form.name);
                ui.label(self.tr("鏂囦欢澶", "Folder"));
                ui.horizontal(|ui| {
                    ui.add(
                        TextEdit::singleline(&mut self.thread_form.folder)
                            .desired_width(ui.available_width() - 90.0),
                    );
                    if ui.button(self.tr("閫夋嫨", "Choose")).clicked() {
                        pick_folder = true;
                    }
                });
                ui.label(self.tr("璇存槑", "Description"));
                ui.add(TextEdit::multiline(&mut self.thread_form.description).desired_rows(3));
                ui.horizontal(|ui| {
                    if ui.button(self.tr("鍒涘缓骞惰繘鍏", "Create & Open")).clicked() {
                        create = true;
                    }
                    if ui.button(self.tr("鍙栨秷", "Cancel")).clicked() {
                        cancel = true;
                    }
                });
            });

        self.show_thread_form = open;
        if cancel {
            self.show_thread_form = false;
        }
        if pick_folder {
            self.import_folder_picker();
        }
        if create {
            self.add_thread_action();
        }
    }

    fn render_model_quick_window_v1(&mut self, ctx: &egui::Context) {
        if !self.show_model_quick_form {
            return;
        }

        let mut open = self.show_model_quick_form;
        let mut save = false;
        let mut save_activate = false;

        egui::Window::new(self.tr("鏂板缓妯″瀷", "New Model"))
            .open(&mut open)
            .collapsible(false)
            .default_width(500.0)
            .show(ctx, |ui| {
                ui.label(self.tr("鍚嶇О", "Name"));
                ui.text_edit_singleline(&mut self.llm_form.name);
                ui.label(self.tr("Provider", "Provider"));
                ui.text_edit_singleline(&mut self.llm_form.provider);
                ui.label(self.tr("Model", "Model"));
                ui.text_edit_singleline(&mut self.llm_form.model);
                ui.label(self.tr("Base URL", "Base URL"));
                ui.text_edit_singleline(&mut self.llm_form.base_url);
                let inline_key_label = self.tr("鐩存帴濉叆 Key", "Inline key");
                let env_key_label = self.tr("鐜鍙橀噺", "Env var");
                let mut key_from_env = self.llm_key_from_env;
                ui.label(self.tr("Key 妯″紡", "Key mode"));
                ui.horizontal(|ui| {
                    ui.selectable_value(
                        &mut key_from_env,
                        false,
                        self.tr("鐩存帴濉叆 Key", "Inline key"),
                    );
                    ui.selectable_value(&mut key_from_env, true, self.tr("鐜鍙橀噺", "Env var"));
                });
                self.llm_key_from_env = key_from_env;

                if self.llm_key_from_env {
                    if self.llm_form.api_key_env.trim().is_empty() {
                        self.llm_form.api_key_env = self.derive_env_var_name();
                    }
                    ui.label(self.tr("鐜鍙橀噺鍚", "Environment variable"));
                    ui.text_edit_singleline(&mut self.llm_form.api_key_env);
                } else {
                    ui.label(self.tr("API Key", "API key"));
                    ui.horizontal(|ui| {
                        ui.add(
                            TextEdit::singleline(&mut self.llm_form.api_key)
                                .password(!self.show_api_key)
                                .desired_width(ui.available_width() - 90.0),
                        );
                        if ui
                            .button(self.tr(
                                if self.show_api_key {
                                    "闅愯棌"
                                } else {
                                    "鏄剧ず"
                                },
                                if self.show_api_key { "Hide" } else { "Show" },
                            ))
                            .clicked()
                        {
                            self.show_api_key = !self.show_api_key;
                        }
                    });
                    ui.horizontal(|ui| {
                        if ui.button(self.tr("鍐欏叆褰撳墠鐜", "Write env")).clicked() {
                            self.write_api_key_to_env_action(false);
                        }
                        if ui
                            .button(self.tr("鍐欏叆骞舵寔涔呭寲", "Write + persist"))
                            .clicked()
                        {
                            self.write_api_key_to_env_action(true);
                        }
                    });
                }

                ui.horizontal(|ui| {
                    if ui.button(self.tr("淇濆瓨", "Save")).clicked() {
                        save = true;
                    }
                    if ui
                        .button(self.tr("淇濆瓨骞舵縺娲", "Save + Activate"))
                        .clicked()
                    {
                        save_activate = true;
                    }
                });
            });

        self.show_model_quick_form = open;
        if save {
            self.save_profile_action();
        }
        if save_activate {
            let profile_name = self.llm_form.name.trim().to_string();
            if self.save_profile_action() {
                self.switch_profile_action(Some(&profile_name));
                self.show_model_quick_form = false;
            }
        }
    }

    fn render_chat_tab_v4(&mut self, ctx: &egui::Context) {
        egui::SidePanel::left("claw_gui_threads_v4")
            .resizable(true)
            .default_width(280.0)
            .min_width(220.0)
            .show(ctx, |ui| self.render_thread_sidebar_v4(ui));

        egui::SidePanel::right("claw_gui_inspector_v4")
            .resizable(true)
            .default_width(330.0)
            .min_width(280.0)
            .show(ctx, |ui| self.render_inspector_v3(ui));

        egui::CentralPanel::default().show(ctx, |ui| self.render_chat_stream_v6(ui));
    }

    fn render_thread_sidebar_v4(&mut self, ui: &mut egui::Ui) {
        let threads = self
            .agent_store
            .as_ref()
            .map(AgentWorkspaceStore::list_threads)
            .unwrap_or_default();

        let mut grouped = BTreeMap::<String, Vec<ThreadRecord>>::new();
        for thread in threads {
            grouped
                .entry(thread.folder.clone())
                .or_default()
                .push(thread);
        }

        let mut activate_name = None::<String>;
        let mut remove_name = None::<String>;
        let mut import_folder = false;

        ScrollArea::vertical().auto_shrink([false, false]).show(ui, |ui| {
            section_card(ui, self.theme, self.tr("绾跨▼", "Threads"), |ui| {
                ui.horizontal(|ui| {
                    if ui.button(self.tr("瀵煎叆鏂囦欢澶", "Import Folder")).clicked() {
                        import_folder = true;
                    }
                    if ui.button(self.tr("鏂扮嚎绋", "New Thread")).clicked() {
                        self.show_thread_form = true;
                    }
                });

                ui.add_space(6.0);
                if ui
                    .selectable_label(
                        self.active_thread_name.is_none(),
                        self.tr("褰撳墠宸ヤ綔鍖轰細璇", "Current workspace chat"),
                    )
                    .clicked()
                {
                    self.select_workspace_chat();
                }
                ui.small(self.workspace.display().to_string());
            });

            ui.add_space(10.0);

            if grouped.is_empty() {
                section_card(ui, self.theme, self.tr("鏂囦欢澶", "Folders"), |ui| {
                    ui.label(self.tr(
                        "杩樻病鏈夊鍏ョ殑鏂囦欢澶广€傜偣鍑烩€滃鍏ユ枃浠跺す鈥濆悗锛屼細涓鸿鏂囦欢澶瑰垱寤轰竴涓嚎绋嬪垎缁勩€?,
                        "No folders imported yet. Click Import Folder to create a thread group for that folder.",
                    ));
                });
            } else {
                for (folder, mut folder_threads) in grouped {
                    folder_threads.sort_by(|a, b| a.name.cmp(&b.name));
                    let folder_name = Path::new(&folder)
                        .file_name()
                        .and_then(|value| value.to_str())
                        .unwrap_or(folder.as_str())
                        .to_string();
                    section_card(ui, self.theme, &folder_name, |ui| {
                        ui.small(folder.clone());
                        ui.add_space(4.0);
                        for thread in folder_threads {
                            let selected =
                                self.active_thread_name.as_deref() == Some(thread.name.as_str());
                            Frame::group(ui.style())
                                .fill(self.theme.subpanel_fill())
                                .stroke(Stroke::new(
                                    1.0,
                                    self.theme.accent().gamma_multiply(if selected { 0.55 } else { 0.25 }),
                                ))
                                .show(ui, |ui| {
                                    ui.horizontal(|ui| {
                                        if ui.selectable_label(selected, &thread.name).clicked() {
                                            activate_name = Some(thread.name.clone());
                                        }
                                        ui.with_layout(Layout::right_to_left(Align::Center), |ui| {
                                            if ui.small_button(self.tr("鍒犻櫎", "Remove")).clicked() {
                                                remove_name = Some(thread.name.clone());
                                            }
                                        });
                                    });
                                    if let Some(description) = &thread.description {
                                        if !description.trim().is_empty() {
                                            ui.small(description);
                                        }
                                    }
                                });
                            ui.add_space(6.0);
                        }
                    });
                    ui.add_space(10.0);
                }
            }
        });

        if import_folder {
            self.import_folder_picker();
        }
        if let Some(name) = activate_name {
            self.activate_thread(&name);
        }
        if let Some(name) = remove_name {
            self.remove_thread(&name);
        }
    }

    fn render_chat_stream_v6(&mut self, ui: &mut egui::Ui) {
        let messages = self.active_session.messages.clone();
        let estimated_input = estimate_text_tokens(&self.composer);
        let limits = self
            .llm_store
            .as_ref()
            .map_or_else(TurnTokenLimits::default, LlmProfileStore::turn_token_limits);
        let profiles = self
            .llm_store
            .as_ref()
            .map(LlmProfileStore::list_profiles)
            .unwrap_or_default();
        let composer_hint = self
            .tr(
                "杈撳叆浠诲姟銆侀棶棰樻垨淇敼璇锋眰銆傚綋鍓嶇嚎绋嬩細淇濈暀澶氳疆涓婁笅鏂囥€?,
                "Write a task, question, or edit request. Multi-turn context stays in the current thread.",
            )
            .to_string();

        section_card(ui, self.theme, &self.active_chat_title_clean(), |ui| {
            ui.horizontal_wrapped(|ui| {
                ui.label(format!(
                    "{}: {}",
                    self.tr("鐩綍", "Folder"),
                    self.active_chat_workspace().display()
                ));
                ui.separator();
                ui.label(format!(
                    "{}: {}",
                    self.tr("浼氳瘽", "Session"),
                    self.active_session.session_id
                ));
                ui.separator();
                ui.label(format!(
                    "{}: {}",
                    self.tr("娑堟伅鏁", "Messages"),
                    messages.len()
                ));
            });

            let current_profile = self
                .active_profile_name()
                .unwrap_or_else(|| self.tr("(鏈縺娲", "(none)").to_string());
            let mut selected_profile = self.active_profile_name().unwrap_or_default();

            ui.add_space(6.0);
            ui.horizontal_wrapped(|ui| {
                ui.label(format!(
                    "{}: {}",
                    self.tr("褰撳墠妯″瀷", "Active profile"),
                    current_profile
                ));
                ComboBox::from_id_salt("chat_profile_switch_v6")
                    .selected_text(if selected_profile.is_empty() {
                        self.tr("(鏈縺娲", "(none)")
                    } else {
                        selected_profile.as_str()
                    })
                    .show_ui(ui, |ui| {
                        ui.selectable_value(
                            &mut selected_profile,
                            String::new(),
                            self.tr("(鏈縺娲", "(none)"),
                        );
                        for profile in &profiles {
                            ui.selectable_value(
                                &mut selected_profile,
                                profile.name.clone(),
                                &profile.name,
                            );
                        }
                    });
                if ui.button(self.tr("鏂板缓妯″瀷", "New Model")).clicked() {
                    if self.llm_form.provider.trim().is_empty() {
                        self.llm_form.provider = "deepseek".to_string();
                    }
                    if self.llm_form.model.trim().is_empty() {
                        self.llm_form.model = "deepseek-chat".to_string();
                    }
                    self.show_model_quick_form = true;
                }
                if ui.button(self.tr("娣诲姞鏂囦欢", "Add files")).clicked() {
                    self.add_files_picker();
                }
                if ui
                    .add_enabled(!self.busy, egui::Button::new(self.tr("鍙戦€", "Send")))
                    .clicked()
                {
                    self.send_current_prompt();
                }
                if ui
                    .add_enabled(
                        self.busy,
                        egui::Button::new(self.tr("鏆傚仠", "Pause")),
                    )
                    .clicked()
                {
                    self.pause_generation_action();
                }
                if ui.button(self.tr("妯″瀷椤", "Models")).clicked() {
                    self.active_tab = Tab::Models;
                }
            });

            match self.active_profile_name() {
                Some(active) if active == selected_profile => {}
                Some(_) | None => {
                    if selected_profile.trim().is_empty() {
                        self.switch_profile_action(None);
                    } else {
                        self.switch_profile_action(Some(&selected_profile));
                    }
                }
            }
        });

        if let Some(hint) = self.connection_error_hint() {
            ui.add_space(8.0);
            section_card(
                ui,
                self.theme,
                self.tr("杩炴帴鎻愮ず", "Connection hint"),
                |ui| {
                    if let Some(error) = &self.error {
                        ui.colored_label(Color32::from_rgb(180, 48, 48), error);
                    }
                    ui.small(hint);
                },
            );
        }

        ui.add_space(8.0);
        let composer_height = 240.0;
        let conversation_height = (ui.available_height() - composer_height - 8.0).max(220.0);

        ui.allocate_ui_with_layout(
            egui::vec2(ui.available_width(), conversation_height),
            Layout::top_down(Align::Min),
            |ui| {
                section_card(ui, self.theme, self.tr("瀵硅瘽娴", "Conversation"), |ui| {
                    ui.set_min_height((conversation_height - 16.0).max(180.0));
                    ScrollArea::vertical()
                        .stick_to_bottom(true)
                        .auto_shrink([false, false])
                        .show(ui, |ui| {
                            if messages.is_empty()
                                && self.optimistic_user_prompt.is_none()
                                && self.live_reply.is_empty()
                            {
                                ui.add_space(24.0);
                                ui.vertical_centered(|ui| {
                                    ui.label(
                                        RichText::new(self.tr("寮€濮嬫柊鐨勫杞亰澶", "Start a new multi-turn chat"))
                                            .strong()
                                            .size(18.0),
                                    );
                                    ui.label(self.tr(
                                        "瀵煎叆鏂囦欢澶瑰悗鍦ㄥ乏渚у垱寤虹嚎绋嬶紝鑱婂ぉ鍖哄彲鐩存帴鍒囨ā鍨嬨€侀檮鍔犳枃浠跺苟鍙戦€併€?,
                                        "Import folders on the left, create threads, then switch models, attach files, and send from the chat area.",
                                    ));
                                });
                                ui.add_space(24.0);
                            }

                            for message in messages
                                .iter()
                                .filter(|message| message.role != MessageRole::System)
                            {
                                render_message_card_v3(ui, message, self.language, self.theme);
                                ui.add_space(8.0);
                            }

                            if let Some(prompt) = &self.optimistic_user_prompt {
                                let pending = ConversationMessage {
                                    role: MessageRole::User,
                                    blocks: vec![ContentBlock::Text { text: prompt.clone() }],
                                    usage: None,
                                };
                                render_message_card_v3(ui, &pending, self.language, self.theme);
                                ui.add_space(8.0);
                            }

                            if !self.live_reply.is_empty() {
                                let streaming = ConversationMessage {
                                    role: MessageRole::Assistant,
                                    blocks: vec![ContentBlock::Text {
                                        text: self.live_reply.clone(),
                                    }],
                                    usage: None,
                                };
                                render_message_card_v3(ui, &streaming, self.language, self.theme);
                            }
                        });
                });
            },
        );

        ui.add_space(8.0);
        section_card(ui, self.theme, self.tr("杈撳叆鍖", "Composer"), |ui| {
            ui.horizontal_wrapped(|ui| {
                ui.label(format!(
                    "{}: {}",
                    self.tr("棰勪及杈撳叆 Token", "Estimated input tokens"),
                    estimated_input
                ));
                ui.separator();
                ui.label(format!(
                    "{}: {}",
                    self.tr("闄愰", "Limits"),
                    limits.summary_line()
                ));
                ui.separator();
                ui.label(format!(
                    "{}: {}",
                    self.tr("Profile", "Profile"),
                    self.active_profile_name()
                        .unwrap_or_else(|| self.tr("(鏈縺娲", "(none)").to_string())
                ));
                ui.separator();
                ui.label(self.tr("蹇嵎閿? Ctrl+Enter 鍙戦€", "Shortcut: Ctrl+Enter to send"));
            });

            ui.horizontal_wrapped(|ui| {
                if ui.button(self.tr("娣诲姞鏂囦欢", "Add files")).clicked() {
                    self.add_files_picker();
                }
                if ui
                    .add_enabled(!self.busy, egui::Button::new(self.tr("鍙戦€", "Send")))
                    .clicked()
                {
                    self.send_current_prompt();
                }
                if ui
                    .add_enabled(
                        self.busy,
                        egui::Button::new(self.tr("鏆傚仠骞剁紪杈戜笂涓€鏉", "Pause & edit last")),
                    )
                    .clicked()
                {
                    self.pause_generation_action();
                }
                if ui.button(self.tr("鏂板缓妯″瀷", "New Model")).clicked() {
                    self.show_model_quick_form = true;
                }
            });

            if !self.attached_files.is_empty() {
                ui.add_space(6.0);
                ui.label(self.tr("宸叉坊鍔犳枃浠", "Attached files"));
                let attached = self.attached_files.clone();
                ui.horizontal_wrapped(|ui| {
                    for path in attached {
                        Frame::group(ui.style())
                            .fill(self.theme.subpanel_fill())
                            .show(ui, |ui| {
                                ui.horizontal(|ui| {
                                    let label = path
                                        .file_name()
                                        .and_then(|value| value.to_str())
                                        .map(ToOwned::to_owned)
                                        .unwrap_or_else(|| path.to_string_lossy().to_string());
                                    ui.small(label);
                                    if ui.small_button("x").clicked() {
                                        self.remove_attached_file(&path);
                                    }
                                });
                            });
                    }
                });
            }

            ui.add_enabled(
                !self.busy,
                TextEdit::multiline(&mut self.composer)
                    .desired_rows(6)
                    .hint_text(composer_hint),
            );
        });
    }

    fn render_models_tab_v5(&mut self, ctx: &egui::Context) {
        let profiles = self
            .llm_store
            .as_ref()
            .map(LlmProfileStore::list_profiles)
            .unwrap_or_default();
        let limits_summary = self
            .llm_store
            .as_ref()
            .map_or_else(TurnTokenLimits::default, LlmProfileStore::turn_token_limits)
            .summary_line();

        egui::CentralPanel::default().show(ctx, |ui| {
            ui.columns(2, |columns| {
                section_card(&mut columns[0], self.theme, self.tr("妯″瀷閰嶇疆", "Model Profile"), |ui| {
                    ui.label(self.tr("鍚嶇О", "Name"));
                    ui.text_edit_singleline(&mut self.llm_form.name);
                    ui.label(self.tr("Provider", "Provider"));
                    ui.text_edit_singleline(&mut self.llm_form.provider);
                    ui.label(self.tr("Model", "Model"));
                    ui.text_edit_singleline(&mut self.llm_form.model);
                    ui.label(self.tr("Base URL", "Base URL"));
                    ui.text_edit_singleline(&mut self.llm_form.base_url);
                    let mut key_from_env = self.llm_key_from_env;

                    ui.horizontal(|ui| {
                        ui.selectable_value(
                            &mut key_from_env,
                            false,
                            self.tr("鐩存帴濉叆 Key", "Inline key"),
                        );
                        ui.selectable_value(
                            &mut key_from_env,
                            true,
                            self.tr("鐜鍙橀噺", "Env var"),
                        );
                    });
                    self.llm_key_from_env = key_from_env;

                    if self.llm_form.api_key_env.trim().is_empty() {
                        self.llm_form.api_key_env = self.derive_env_var_name();
                    }
                    ui.label(self.tr("鐜鍙橀噺鍚", "Environment variable"));
                    ui.text_edit_singleline(&mut self.llm_form.api_key_env);

                    if self.llm_key_from_env {
                        ui.small(self.tr(
                            "当前 profile 会优先从上面的环境变量读取 Key。",
                            "This profile will read its API key from the environment variable above.",
                        ));
                    }

                    ui.label(self.tr("API Key", "API key"));
                    ui.horizontal(|ui| {
                        ui.add(
                            TextEdit::singleline(&mut self.llm_form.api_key)
                                .password(!self.show_api_key)
                                .desired_width(ui.available_width() - 90.0),
                        );
                        if ui
                            .button(self.tr(
                                if self.show_api_key { "隐藏" } else { "显示" },
                                if self.show_api_key { "Hide" } else { "Show" },
                            ))
                            .clicked()
                        {
                            self.show_api_key = !self.show_api_key;
                        }
                    });
                    ui.horizontal(|ui| {
                        if ui.button(self.tr("写入当前环境", "Write env")).clicked() {
                            self.write_api_key_to_env_action(false);
                        }
                        if ui
                            .button(self.tr("写入并持久化", "Write + persist"))
                            .clicked()
                        {
                            self.write_api_key_to_env_action(true);
                        }
                    });

                    ui.horizontal(|ui| {
                        if ui.button(self.tr("淇濆瓨", "Save")).clicked() {
                            self.save_profile_action();
                        }
                        if ui.button(self.tr("淇濆瓨骞舵縺娲", "Save + Activate")).clicked() {
                            let profile_name = self.llm_form.name.trim().to_string();
                            if self.save_profile_action() {
                                self.switch_profile_action(Some(&profile_name));
                            }
                        }
                        if ui.button(self.tr("娓呯┖琛ㄥ崟", "Clear form")).clicked() {
                            self.llm_form = LlmForm::default();
                            self.llm_key_from_env = false;
                        }
                    });
                });

                section_card(&mut columns[1], self.theme, self.tr("宸插鍏ユā鍨", "Imported Profiles"), |ui| {
                    ui.label(format!(
                        "{}: {}",
                        self.tr("褰撳墠闄愰", "Current limits"),
                        limits_summary
                    ));
                    ui.add_space(4.0);

                    if profiles.is_empty() {
                        ui.label(self.tr(
                            "杩樻病鏈夊凡淇濆瓨妯″瀷銆傚厛杈撳叆 Key 骞朵繚瀛樹竴涓ā鍨嬮厤缃€?,
                            "No saved profiles yet. Enter a key and save a model profile first.",
                        ));
                    } else {
                        let mut activate_name = None::<String>;
                        let mut remove_name = None::<String>;
                        let mut edit_profile = None::<LlmProfile>;

                        for profile in profiles {
                            let active =
                                self.active_profile_name().as_deref() == Some(profile.name.as_str());
                            Frame::group(ui.style())
                                .fill(self.theme.subpanel_fill())
                                .stroke(Stroke::new(1.0, self.theme.accent().gamma_multiply(0.30)))
                                .show(ui, |ui| {
                                    ui.horizontal_wrapped(|ui| {
                                        ui.label(
                                            RichText::new(&profile.name)
                                                .strong()
                                                .color(if active {
                                                    self.theme.accent()
                                                } else {
                                                    ui.visuals().text_color()
                                                }),
                                        );
                                        if active {
                                            ui.label(self.tr("褰撳墠婵€娲", "Active"));
                                        }
                                    });
                                    ui.small(format!(
                                        "provider={} model={}",
                                        profile.normalized_provider(),
                                        profile.model
                                    ));
                                    ui.small(format!(
                                        "{}: {}",
                                        self.tr("Key 鏉ユ簮", "Key source"),
                                        profile.key_source_label()
                                    ));
                                    ui.small(format!(
                                        "{}: {}",
                                        self.tr("Key 棰勮", "Key preview"),
                                        profile.masked_key_preview()
                                    ));
                                    ui.horizontal(|ui| {
                                        if ui.button(self.tr("缂栬緫", "Edit")).clicked() {
                                            edit_profile = Some(profile.clone());
                                        }
                                        if ui.button(self.tr("婵€娲", "Activate")).clicked() {
                                            activate_name = Some(profile.name.clone());
                                        }
                                        if ui.button(self.tr("鍒犻櫎", "Remove")).clicked() {
                                            remove_name = Some(profile.name.clone());
                                        }
                                    });
                                });
                            ui.add_space(6.0);
                        }

                        if let Some(profile) = edit_profile {
                            self.load_profile_into_form(&profile);
                        }
                        if let Some(name) = activate_name {
                            self.switch_profile_action(Some(&name));
                        }
                        if let Some(name) = remove_name {
                            self.remove_profile(&name);
                        }
                    }
                });
            });
        });
    }
}

impl eframe::App for ClawGuiApp {
    fn update(&mut self, ctx: &eframe::egui::Context, _frame: &mut eframe::Frame) {
        self.apply_visuals(ctx);
        self.poll_worker_clean();
        if self.busy {
            ctx.request_repaint_after(Duration::from_millis(120));
        }

        let send_shortcut = ctx.input(|input| {
            input.key_pressed(egui::Key::Enter) && (input.modifiers.command || input.modifiers.ctrl)
        });
        if self.active_tab == Tab::Chat && send_shortcut {
            self.send_current_prompt();
        }

        self.render_top_bar_v3(ctx);
        self.render_help_window_v3(ctx);
        self.render_thread_window_v4(ctx);
        self.render_model_quick_window_v1(ctx);

        match self.active_tab {
            Tab::Chat => self.render_chat_tab_v4(ctx),
            Tab::Models => self.render_models_tab_v5(ctx),
            Tab::Apps => self.render_apps_tab_v3(ctx),
            Tab::Sessions => self.render_sessions_tab_v3(ctx),
        }
    }
}

fn tab_label(tab: Tab, language: Language) -> &'static str {
    match tab {
        Tab::Chat => language.pick("鑱婂ぉ", "Chat"),
        Tab::Models => language.pick("妯″瀷", "Models"),
        Tab::Apps => language.pick("搴旂敤", "Apps"),
        Tab::Sessions => language.pick("浼氳瘽", "Sessions"),
    }
}

fn language_label(language: Language) -> &'static str {
    match language {
        Language::Zh => "涓枃",
        Language::En => "English",
    }
}

fn theme_label(theme: UiTheme, language: Language) -> &'static str {
    match theme {
        UiTheme::Sand => language.pick("鏆栨矙", "Sand"),
        UiTheme::Mist => language.pick("钖勯浘", "Mist"),
        UiTheme::Forest => language.pick("妫灄", "Forest"),
        UiTheme::Graphite => language.pick("鐭冲ⅷ", "Graphite"),
    }
}

fn section_card(
    ui: &mut egui::Ui,
    theme: UiTheme,
    title: &str,
    add_contents: impl FnOnce(&mut egui::Ui),
) {
    Frame::group(ui.style())
        .fill(theme.subpanel_fill())
        .stroke(Stroke::new(1.0, theme.accent().gamma_multiply(0.30)))
        .show(ui, |ui| {
            ui.label(RichText::new(title).strong().color(theme.accent()));
            ui.add_space(6.0);
            add_contents(ui);
        });
}

fn render_message_card_v3(
    ui: &mut egui::Ui,
    message: &ConversationMessage,
    language: Language,
    theme: UiTheme,
) {
    let (title, accent) = match message.role {
        MessageRole::User => (language.pick("鐢ㄦ埛", "User"), theme.accent()),
        MessageRole::Assistant => (
            language.pick("鍔╂墜", "Assistant"),
            Color32::from_rgb(79, 103, 188),
        ),
        MessageRole::Tool => (
            language.pick("宸ュ叿", "Tool"),
            Color32::from_rgb(95, 130, 88),
        ),
        MessageRole::System => (
            language.pick("绯荤粺", "System"),
            Color32::from_rgb(120, 120, 120),
        ),
    };

    let fill = match message.role {
        MessageRole::User => theme.accent().gamma_multiply(0.08),
        MessageRole::Assistant => theme.subpanel_fill(),
        MessageRole::Tool => Color32::from_rgb(230, 241, 230).gamma_multiply(0.95),
        MessageRole::System => theme.subpanel_fill(),
    };

    Frame::group(ui.style())
        .fill(fill)
        .stroke(Stroke::new(1.0, accent.gamma_multiply(0.35)))
        .show(ui, |ui| {
            ui.horizontal_wrapped(|ui| {
                ui.label(RichText::new(title).strong().color(accent));
                if let Some(usage) = message.usage {
                    ui.separator();
                    ui.small(format!("Token {}", token_total(usage)));
                }
            });

            for block in &message.blocks {
                match block {
                    ContentBlock::Text { text } => {
                        ui.label(text);
                    }
                    ContentBlock::ToolUse { name, input, .. } => {
                        render_tool_block_v3(
                            ui,
                            language.pick("宸ュ叿璋冪敤", "Tool call"),
                            name,
                            input,
                            false,
                            theme,
                        );
                    }
                    ContentBlock::ToolResult {
                        tool_name,
                        output,
                        is_error,
                        ..
                    } => {
                        render_tool_block_v3(
                            ui,
                            language.pick("宸ュ叿缁撴灉", "Tool result"),
                            tool_name,
                            output,
                            *is_error,
                            theme,
                        );
                    }
                }
                ui.add_space(4.0);
            }
        });
}

fn render_tool_block_v3(
    ui: &mut egui::Ui,
    kind: &str,
    name: &str,
    body: &str,
    is_error: bool,
    theme: UiTheme,
) {
    let color = if is_error {
        Color32::from_rgb(183, 63, 63)
    } else {
        theme.accent()
    };

    Frame::group(ui.style())
        .fill(theme.subpanel_fill())
        .stroke(Stroke::new(1.0, color.gamma_multiply(0.4)))
        .show(ui, |ui| {
            ui.label(
                RichText::new(format!("{kind}: {name}"))
                    .strong()
                    .color(color),
            );
            ui.monospace(truncate_text(body, 500));
        });
}

fn render_tool_event_card_v1(
    ui: &mut egui::Ui,
    event: &InspectorEvent,
    language: Language,
    theme: UiTheme,
) {
    let color = if event.is_error {
        Color32::from_rgb(183, 63, 63)
    } else {
        Color32::from_rgb(95, 130, 88)
    };
    Frame::group(ui.style())
        .fill(theme.subpanel_fill())
        .stroke(Stroke::new(1.0, color.gamma_multiply(0.35)))
        .show(ui, |ui| {
            ui.horizontal_wrapped(|ui| {
                ui.label(
                    RichText::new(language.pick("工具事件", "Tool Event"))
                        .strong()
                        .color(color),
                );
                ui.separator();
                ui.small(RichText::new(&event.title).color(color));
            });
            ui.label(&event.body);
        });
}

#[allow(dead_code)]
fn render_message_card(
    ui: &mut egui::Ui,
    message: &ConversationMessage,
    language: Language,
    theme: UiTheme,
) {
    let (title, accent) = match message.role {
        MessageRole::User => (language.pick("鐢ㄦ埛", "User"), theme.accent()),
        MessageRole::Assistant => (
            language.pick("鍔╂墜", "Assistant"),
            Color32::from_rgb(79, 103, 188),
        ),
        MessageRole::Tool => (
            language.pick("宸ュ叿", "Tool"),
            Color32::from_rgb(95, 130, 88),
        ),
        MessageRole::System => (
            language.pick("绯荤粺", "System"),
            Color32::from_rgb(120, 120, 120),
        ),
    };

    let fill = match message.role {
        MessageRole::User => theme.accent().gamma_multiply(0.08),
        MessageRole::Assistant => theme.subpanel_fill(),
        MessageRole::Tool => Color32::from_rgb(230, 241, 230).gamma_multiply(0.95),
        MessageRole::System => theme.subpanel_fill(),
    };

    Frame::group(ui.style())
        .fill(fill)
        .stroke(Stroke::new(1.0, accent.gamma_multiply(0.35)))
        .show(ui, |ui| {
            ui.horizontal_wrapped(|ui| {
                ui.label(RichText::new(title).strong().color(accent));
                if let Some(usage) = message.usage {
                    ui.separator();
                    ui.small(format!(
                        "{} {}",
                        language.pick("token", "tokens"),
                        token_total(usage)
                    ));
                }
            });

            for block in &message.blocks {
                match block {
                    ContentBlock::Text { text } => {
                        ui.label(text);
                    }
                    ContentBlock::ToolUse { name, input, .. } => {
                        render_tool_block(
                            ui,
                            language.pick("宸ュ叿璋冪敤", "Tool call"),
                            name,
                            input,
                            false,
                            theme,
                        );
                    }
                    ContentBlock::ToolResult {
                        tool_name,
                        output,
                        is_error,
                        ..
                    } => {
                        render_tool_block(
                            ui,
                            language.pick("宸ュ叿缁撴灉", "Tool result"),
                            tool_name,
                            output,
                            *is_error,
                            theme,
                        );
                    }
                }
                ui.add_space(4.0);
            }
        });
}

#[allow(dead_code)]
fn render_message_card_v2(
    ui: &mut egui::Ui,
    message: &ConversationMessage,
    language: Language,
    theme: UiTheme,
) {
    let (title, accent) = match message.role {
        MessageRole::User => (language.pick("鐢ㄦ埛", "User"), theme.accent()),
        MessageRole::Assistant => (
            language.pick("鍔╂墜", "Assistant"),
            Color32::from_rgb(79, 103, 188),
        ),
        MessageRole::Tool => (
            language.pick("宸ュ叿", "Tool"),
            Color32::from_rgb(95, 130, 88),
        ),
        MessageRole::System => (
            language.pick("绯荤粺", "System"),
            Color32::from_rgb(120, 120, 120),
        ),
    };

    let fill = match message.role {
        MessageRole::User => theme.accent().gamma_multiply(0.08),
        MessageRole::Assistant => theme.subpanel_fill(),
        MessageRole::Tool => Color32::from_rgb(230, 241, 230).gamma_multiply(0.95),
        MessageRole::System => theme.subpanel_fill(),
    };

    Frame::group(ui.style())
        .fill(fill)
        .stroke(Stroke::new(1.0, accent.gamma_multiply(0.35)))
        .show(ui, |ui| {
            ui.horizontal_wrapped(|ui| {
                ui.label(RichText::new(title).strong().color(accent));
                if let Some(usage) = message.usage {
                    ui.separator();
                    ui.small(format!(
                        "{} {}",
                        language.pick("token", "tokens"),
                        token_total(usage)
                    ));
                }
            });

            for block in &message.blocks {
                match block {
                    ContentBlock::Text { text } => {
                        ui.label(text);
                    }
                    ContentBlock::ToolUse { name, input, .. } => {
                        render_tool_block_v2(
                            ui,
                            language.pick("宸ュ叿璋冪敤", "Tool call"),
                            name,
                            input,
                            false,
                            theme,
                        );
                    }
                    ContentBlock::ToolResult {
                        tool_name,
                        output,
                        is_error,
                        ..
                    } => {
                        render_tool_block_v2(
                            ui,
                            language.pick("宸ュ叿缁撴灉", "Tool result"),
                            tool_name,
                            output,
                            *is_error,
                            theme,
                        );
                    }
                }
                ui.add_space(4.0);
            }
        });
}

#[allow(dead_code)]
fn render_tool_block(
    ui: &mut egui::Ui,
    kind: &str,
    name: &str,
    body: &str,
    is_error: bool,
    theme: UiTheme,
) {
    let color = if is_error {
        Color32::from_rgb(183, 63, 63)
    } else {
        theme.accent()
    };

    Frame::group(ui.style())
        .fill(theme.subpanel_fill())
        .stroke(Stroke::new(1.0, color.gamma_multiply(0.4)))
        .show(ui, |ui| {
            ui.label(
                RichText::new(format!("{kind}: {name}"))
                    .strong()
                    .color(color),
            );
            ui.monospace(truncate_text(body, 500));
        });
}

#[allow(dead_code)]
fn render_tool_block_v2(
    ui: &mut egui::Ui,
    kind: &str,
    name: &str,
    body: &str,
    is_error: bool,
    theme: UiTheme,
) {
    let color = if is_error {
        Color32::from_rgb(183, 63, 63)
    } else {
        theme.accent()
    };

    Frame::group(ui.style())
        .fill(theme.subpanel_fill())
        .stroke(Stroke::new(1.0, color.gamma_multiply(0.4)))
        .show(ui, |ui| {
            ui.label(
                RichText::new(format!("{kind}: {name}"))
                    .strong()
                    .color(color),
            );
            ui.monospace(truncate_text(body, 500));
        });
}

fn optional_text(value: &str) -> Option<String> {
    let trimmed = value.trim();
    (!trimmed.is_empty()).then(|| trimmed.to_string())
}

fn optional_u32_text(value: Option<u32>) -> String {
    value.map_or_else(String::new, |number| number.to_string())
}

fn parse_optional_u32(value: &str) -> Result<Option<u32>, String> {
    let trimmed = value.trim();
    if trimmed.is_empty() {
        return Ok(None);
    }
    trimmed
        .parse::<u32>()
        .map(Some)
        .map_err(|error| format!("invalid integer '{trimmed}': {error}"))
}

fn absolute_folder(base: &Path, input: &str) -> PathBuf {
    let path = PathBuf::from(input);
    if path.is_absolute() {
        path
    } else {
        base.join(path)
    }
}

fn truncate_text(value: &str, max_chars: usize) -> String {
    let total = value.chars().count();
    if total <= max_chars {
        return value.to_string();
    }
    let shortened = value.chars().take(max_chars).collect::<String>();
    format!("{shortened}...")
}

fn token_total(usage: TokenUsage) -> u32 {
    usage.input_tokens
        + usage.output_tokens
        + usage.cache_creation_input_tokens
        + usage.cache_read_input_tokens
}

trait StringExt {
    fn if_empty(self, fallback: &str) -> String;
}

impl StringExt for String {
    fn if_empty(self, fallback: &str) -> String {
        if self.trim().is_empty() {
            fallback.to_string()
        } else {
            self
        }
    }
}

fn collect_workspace_entries(root: &Path, max_depth: usize, max_entries: usize) -> Vec<String> {
    fn walk(
        current: &Path,
        base: &Path,
        depth: usize,
        max_depth: usize,
        max_entries: usize,
        out: &mut Vec<String>,
    ) {
        if depth > max_depth || out.len() >= max_entries {
            return;
        }

        let Ok(read_dir) = std::fs::read_dir(current) else {
            return;
        };

        let mut entries = read_dir
            .filter_map(Result::ok)
            .map(|entry| entry.path())
            .collect::<Vec<_>>();
        entries.sort();

        for path in entries {
            if out.len() >= max_entries {
                break;
            }
            let name = path
                .strip_prefix(base)
                .ok()
                .unwrap_or(path.as_path())
                .display()
                .to_string();
            let is_dir = path.is_dir();
            let indent = "  ".repeat(depth);
            let marker = if is_dir { "[D]" } else { "[F]" };
            out.push(format!("{indent}{marker} {name}"));

            if is_dir {
                walk(&path, base, depth + 1, max_depth, max_entries, out);
            }
        }
    }

    let mut out = Vec::new();
    walk(root, root, 0, max_depth, max_entries, &mut out);
    out
}

fn collect_skill_names(workspace: &Path, max_entries: usize) -> Vec<String> {
    fn push_skill_names(root: &Path, names: &mut BTreeSet<String>, max_entries: usize) {
        if !root.exists() || names.len() >= max_entries {
            return;
        }
        let Ok(read_dir) = std::fs::read_dir(root) else {
            return;
        };

        for entry in read_dir.filter_map(Result::ok) {
            if names.len() >= max_entries {
                break;
            }
            let path = entry.path();
            if path.is_dir() {
                let direct_skill = path.join("SKILL.md");
                if direct_skill.exists() {
                    if let Some(name) = path.file_name().and_then(|value| value.to_str()) {
                        names.insert(name.to_string());
                    }
                    continue;
                }

                if let Ok(children) = std::fs::read_dir(&path) {
                    for child in children.filter_map(Result::ok) {
                        let child_path = child.path();
                        if child_path.is_dir() && child_path.join("SKILL.md").exists() {
                            if let Some(name) =
                                child_path.file_name().and_then(|value| value.to_str())
                            {
                                names.insert(name.to_string());
                            }
                        }
                        if names.len() >= max_entries {
                            break;
                        }
                    }
                }
            }
        }
    }

    let mut roots = Vec::new();
    roots.push(workspace.join(".claw").join("skills"));
    if let Ok(codex_home) = std::env::var("CODEX_HOME") {
        roots.push(PathBuf::from(codex_home).join("skills"));
    }
    if let Ok(user_profile) = std::env::var("USERPROFILE") {
        roots.push(PathBuf::from(user_profile).join(".codex").join("skills"));
    }

    let mut names = BTreeSet::new();
    for root in roots {
        push_skill_names(&root, &mut names, max_entries);
        if names.len() >= max_entries {
            break;
        }
    }

    names.into_iter().collect()
}

fn configure_gui_fonts(ctx: &egui::Context) {
    let Some((font_name, font_bytes)) = load_cjk_font() else {
        return;
    };

    let mut fonts = egui::FontDefinitions::default();
    fonts.font_data.insert(
        font_name.clone(),
        egui::FontData::from_owned(font_bytes).into(),
    );

    if let Some(family) = fonts.families.get_mut(&egui::FontFamily::Proportional) {
        family.insert(0, font_name.clone());
    }
    if let Some(family) = fonts.families.get_mut(&egui::FontFamily::Monospace) {
        family.push(font_name);
    }

    ctx.set_fonts(fonts);
}

fn load_cjk_font() -> Option<(String, Vec<u8>)> {
    for path in preferred_cjk_font_paths() {
        let Ok(bytes) = std::fs::read(&path) else {
            continue;
        };
        if bytes.is_empty() {
            continue;
        }
        let name = path
            .file_stem()
            .map(|value| value.to_string_lossy().to_string())
            .unwrap_or_else(|| "claw-cjk".to_string());
        return Some((format!("claw-{name}"), bytes));
    }
    None
}

fn preferred_cjk_font_paths() -> Vec<PathBuf> {
    let windows_fonts = std::env::var("WINDIR")
        .map(PathBuf::from)
        .unwrap_or_else(|_| PathBuf::from("C:\\Windows"))
        .join("Fonts");

    vec![
        windows_fonts.join("NotoSansSC-VF.ttf"),
        windows_fonts.join("Noto Sans SC (TrueType).otf"),
        windows_fonts.join("simhei.ttf"),
        windows_fonts.join("Deng.ttf"),
        windows_fonts.join("msyh.ttc"),
    ]
}

fn main() -> eframe::Result<()> {
    let options = eframe::NativeOptions {
        viewport: egui::ViewportBuilder::default()
            .with_title("Claw GUI")
            .with_inner_size([1480.0, 920.0])
            .with_min_inner_size([1180.0, 760.0]),
        ..Default::default()
    };

    eframe::run_native(
        "Claw GUI",
        options,
        Box::new(|cc| {
            configure_gui_fonts(&cc.egui_ctx);
            Ok(Box::new(ClawGuiApp::new()))
        }),
    )
}
